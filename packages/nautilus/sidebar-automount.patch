+static char *
+automount_id_for_row (NautilusSidebarRow *row)
+{
+    g_autoptr (GVolume) volume = NULL;
+    g_autoptr (GMount) mount = NULL;
+    g_autofree char *device = NULL;
+    g_autofree char *uuid = NULL;
+
+    if (row == NULL)
+    {
+        return NULL;
+    }
+
+    g_object_get (row, "volume", &volume, "mount", &mount, NULL);
+    if (volume == NULL && mount != NULL)
+    {
+        volume = g_mount_get_volume (mount);
+    }
+    if (volume == NULL)
+    {
+        return NULL;
+    }
+
+    device = g_volume_get_identifier (volume, G_VOLUME_IDENTIFIER_KIND_UNIX_DEVICE);
+    uuid = g_volume_get_identifier (volume, G_VOLUME_IDENTIFIER_KIND_UUID);
+    if (device == NULL || !g_str_has_prefix (device, "/dev/") ||
+        uuid == NULL || *uuid == '\0')
+    {
+        return NULL;
+    }
+
+    return g_steal_pointer (&uuid);
+}
+
+static GSettings *
+get_automount_settings (void)
+{
+    GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+    g_autoptr (GSettingsSchema) schema = NULL;
+
+    if (source != NULL)
+    {
+        schema = g_settings_schema_source_lookup (source, "org.infinityos.automount", TRUE);
+    }
+    return schema != NULL ? g_settings_new_full (schema, NULL, NULL) : NULL;
+}
+
+static void
+automount_configure_finished (GObject      *source,
+                              GAsyncResult *result,
+                              gpointer      data)
+{
+    g_autoptr (GObject) owner = data;
+    NautilusSidebar *sidebar = NAUTILUS_PLACES_SIDEBAR (owner);
+    GSubprocess *process = G_SUBPROCESS (source);
+    GAction *action = g_action_map_lookup_action (G_ACTION_MAP (sidebar->row_actions), "automount");
+    const char *uuid = g_object_get_data (G_OBJECT (action), "automount-menu-uuid");
+    g_autofree char *message = NULL;
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GSettings) settings = get_automount_settings ();
+
+    g_object_set_data (G_OBJECT (action), "automount-configuring", NULL);
+    g_simple_action_set_enabled (G_SIMPLE_ACTION (action),
+                                 settings != NULL && g_settings_is_writable (settings, "volume-uuids"));
+    if (!g_subprocess_communicate_utf8_finish (process, result, NULL, &message, &error) ||
+        !g_subprocess_get_successful (process))
+    {
+        if (gtk_widget_get_root (GTK_WIDGET (sidebar)) != NULL)
+        {
+            const char *detail = error != NULL ? error->message : (message != NULL ? g_strstrip (message) : "");
+            show_error_message (sidebar, _("Could not change Automount"), detail);
+        }
+        return;
+    }
+
+    if (g_strcmp0 (uuid, g_object_get_data (source, "automount-uuid")) == 0)
+    {
+        g_simple_action_set_state (G_SIMPLE_ACTION (action),
+                                   g_variant_new_boolean (GPOINTER_TO_INT (g_object_get_data (source, "automount-enabled"))));
+    }
+}
+
+static void
+automount_change_state (GSimpleAction *action,
+                        GVariant      *state,
+                        gpointer       data)
+{
+    NautilusSidebar *sidebar = data;
+    g_autofree char *uuid = automount_id_for_row (sidebar->context_row);
+    g_autoptr (GSubprocess) process = NULL;
+    g_autoptr (GError) error = NULL;
+    gboolean enabled = g_variant_get_boolean (state);
+
+    if (uuid == NULL || g_object_get_data (G_OBJECT (action), "automount-configuring") != NULL)
+    {
+        return;
+    }
+
+    process = g_subprocess_new (G_SUBPROCESS_FLAGS_STDERR_PIPE | G_SUBPROCESS_FLAGS_STDOUT_SILENCE,
+                                &error, "/usr/libexec/infinityos-automount", "--configure",
+                                uuid, enabled ? "on" : "off", NULL);
+    if (process == NULL)
+    {
+        show_error_message (sidebar, _("Could not change Automount"), error->message);
+        return;
+    }
+    g_object_set_data (G_OBJECT (action), "automount-configuring", GINT_TO_POINTER (TRUE));
+    g_simple_action_set_enabled (action, FALSE);
+    g_object_set_data_full (G_OBJECT (process), "automount-uuid", g_steal_pointer (&uuid), g_free);
+    g_object_set_data (G_OBJECT (process), "automount-enabled", GINT_TO_POINTER (enabled));
+    g_subprocess_communicate_utf8_async (process, NULL, NULL, automount_configure_finished,
+                                         g_object_ref (sidebar));
+}
+
