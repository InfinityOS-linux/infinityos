+static char *
+automount_id_for_row (NautilusSidebarRow  *row,
+                      char              **device_out)
+{
+    g_autoptr (GVolume) volume = NULL;
+    g_autoptr (GMount) mount = NULL;
+    g_autofree char *device = NULL;
+    g_autofree char *uuid = NULL;
+
+    if (row == NULL)
+    {
+        return NULL;
+    }
+
+    g_object_get (row, "volume", &volume, "mount", &mount, NULL);
+    if (volume == NULL && mount != NULL)
+    {
+        volume = g_mount_get_volume (mount);
+    }
+    if (volume == NULL)
+    {
+        return NULL;
+    }
+
+    device = g_volume_get_identifier (volume, G_VOLUME_IDENTIFIER_KIND_UNIX_DEVICE);
+    uuid = g_volume_get_identifier (volume, G_VOLUME_IDENTIFIER_KIND_UUID);
+    if (device == NULL || !g_str_has_prefix (device, "/dev/") ||
+        uuid == NULL || *uuid == '\0')
+    {
+        return NULL;
+    }
+
+    if (device_out != NULL)
+    {
+        *device_out = g_steal_pointer (&device);
+    }
+    return g_steal_pointer (&uuid);
+}
+
+static GSettings *
+get_automount_settings (void)
+{
+    GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+    g_autoptr (GSettingsSchema) schema = NULL;
+
+    if (source != NULL)
+    {
+        schema = g_settings_schema_source_lookup (source, "org.infinityos.automount", TRUE);
+    }
+    return schema != NULL ? g_settings_new_full (schema, NULL, NULL) : NULL;
+}
+
+typedef struct
+{
+    GSimpleAction *action;
+    GVariant *state;
+    char *uuid;
+} AutomountRequest;
+
+static void
+automount_configured (GObject      *source,
+                      GAsyncResult *result,
+                      gpointer      data)
+{
+    AutomountRequest *request = data;
+    g_autoptr (GError) error = NULL;
+
+    if (g_subprocess_wait_check_finish (G_SUBPROCESS (source), result, &error))
+    {
+        const char *menu_uuid = g_object_get_data (G_OBJECT (request->action), "infinityos-automount-uuid");
+        if (g_strcmp0 (menu_uuid, request->uuid) == 0)
+        {
+            g_simple_action_set_state (request->action, request->state);
+        }
+    }
+    else if (!g_error_matches (error, G_SPAWN_EXIT_ERROR, 126) &&
+             !g_error_matches (error, G_SPAWN_EXIT_ERROR, 127))
+    {
+        g_warning ("Could not configure InfinityOS Automount: %s", error->message);
+    }
+
+    g_object_unref (request->action);
+    g_variant_unref (request->state);
+    g_free (request->uuid);
+    g_free (request);
+}
+
+static void
+automount_change_state (GSimpleAction *action,
+                        GVariant      *state,
+                        gpointer       data)
+{
+    NautilusSidebar *sidebar = data;
+    g_autofree char *device = NULL;
+    g_autofree char *uuid = automount_id_for_row (sidebar->context_row, &device);
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GSubprocess) process = NULL;
+    AutomountRequest *request;
+
+    if (uuid == NULL)
+    {
+        return;
+    }
+
+    process = g_subprocess_new (G_SUBPROCESS_FLAGS_NONE, &error,
+                                "/usr/libexec/infinityos-configure-automount",
+                                g_variant_get_boolean (state) ? "enable" : "disable",
+                                device, uuid, NULL);
+    if (process == NULL)
+    {
+        g_warning ("Could not open InfinityOS Automount: %s", error->message);
+        return;
+    }
+
+    request = g_new0 (AutomountRequest, 1);
+    request->action = g_object_ref (action);
+    request->state = g_variant_ref (state);
+    request->uuid = g_steal_pointer (&uuid);
+    g_subprocess_wait_check_async (process, NULL, automount_configured, request);
+}
