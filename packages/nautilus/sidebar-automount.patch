+        g_auto (GStrv) ids = g_settings_get_strv (automount_settings, "volume-uuids");
+        action = g_action_map_lookup_action (G_ACTION_MAP (sidebar->row_actions), "automount");
+        g_object_set_data_full (G_OBJECT (action), "automount-menu-uuid", g_strdup (automount_id), g_free);
+        g_simple_action_set_state (G_SIMPLE_ACTION (action),
+                                   g_variant_new_boolean (g_strv_contains ((const char * const *) ids, automount_id)));
+        g_simple_action_set_enabled (G_SIMPLE_ACTION (action),
+                                     g_settings_is_writable (automount_settings, "volume-uuids") &&
+                                     g_object_get_data (G_OBJECT (action), "automount-configuring") == NULL);
+        g_menu_append (section, _("Automount"), "row.automount");
+    }
+
     show_stop = (drive != NULL && g_drive_can_stop (drive));
 
     if (show_unmount && !show_stop)
