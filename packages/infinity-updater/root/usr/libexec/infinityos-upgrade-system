#!/usr/bin/env bash
# The only privileged RPM operation exposed by InfinityUpdater.
set -euo pipefail

if [[ $EUID -ne 0 || ( $# -ne 0 && ( $# -ne 2 || $1 != --local-rpm || ! -f $2 ) ) ]]; then
    echo 'Infinity OS system upgrade must be authorized by polkit.' >&2
    exit 2
fi
if [[ $(findmnt -n -o FSTYPE /) != btrfs ]]; then
    echo 'RPM upgrade stopped: the root filesystem is not Btrfs.' >&2
    exit 1
fi
if [[ ! -f /etc/snapper/configs/root ]] || ! mountpoint -q /.snapshots; then
    echo 'RPM upgrade stopped: Btrfs backups are not ready. Reboot once and retry.' >&2
    exit 1
fi

if [[ -e /etc/infinityos-release-pending.json ]]; then
    echo 'A release upgrade is pending. Retry that release or restore its recovery snapshot first.' >&2
    exit 1
fi
args=()
if [[ $# -eq 2 ]]; then
    args+=("$2")
fi
exec systemd-inhibit --what=shutdown:sleep --mode=block --who=InfinityUpdater \
    --why='Preparing system updates' \
    python3 /usr/share/infinityos/updater/pending.py "${args[@]}"
