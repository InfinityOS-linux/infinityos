#!/usr/bin/env bash
# The only privileged RPM operation exposed by InfinityUpdater.
set -euo pipefail

if [[ $EUID -ne 0 || ( $# -ne 0 && ( $# -ne 2 || $1 != --local-rpm || ! -f $2 ) ) ]]; then
    echo 'Infinity OS system upgrade must be authorized by polkit.' >&2
    exit 2
fi
if [[ $(findmnt -n -o FSTYPE /) != btrfs ]]; then
    echo 'RPM upgrade stopped: the root filesystem is not Btrfs.' >&2
    exit 1
fi
backup_not_ready() {
    local unit=$1 reason=$2 state
    echo "RPM upgrade stopped: $reason" >&2
    state=$(systemctl is-enabled "$unit" 2>/dev/null || true)
    if systemctl is-failed --quiet "$unit"; then
        echo "Backup initialization failed in $unit. Inspect its system journal before retrying." >&2
    elif [[ $state == disabled || $state == masked* || $state == not-found || -z $state ]]; then
        echo "Backup initialization service $unit is not enabled ($state). Restarting alone will not fix this." >&2
    else
        echo "Backup initialization service $unit has not completed. Inspect its system journal and /var/log/infinityos-boot-install.log." >&2
    fi
    echo "Diagnostics: sudo journalctl -b -u $unit --no-pager" >&2
    exit 1
}
if [[ ! -f /etc/snapper/configs/root ]]; then
    backup_not_ready infinityos-snapper-setup.service 'Snapper root configuration is missing.'
fi
if [[ ! -f /var/lib/infinityos/backups-ready ]]; then
    backup_not_ready infinityos-backups-setup.service 'Btrfs backup initialization is incomplete.'
fi
if ! mountpoint -q /.snapshots; then
    backup_not_ready infinityos-backups-setup.service 'Snapshot storage /.snapshots is not mounted.'
fi

if [[ -e /etc/infinityos-release-pending.json ]]; then
    echo 'A release upgrade is pending. Retry that release or restore its recovery snapshot first.' >&2
    exit 1
fi
args=()
if [[ $# -eq 2 ]]; then
    args+=("$2")
fi
exec systemd-inhibit --what=shutdown:sleep --mode=block --who=InfinityUpdater \
    --why='Preparing system updates' \
    python3 /usr/share/infinityos/updater/pending.py "${args[@]}"
