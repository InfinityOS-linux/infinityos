// Only the local active administrator may update without an authentication dialog.
polkit.addRule(function(action, subject) {
    if (action.id !== 'org.freedesktop.policykit.exec' ||
        !subject.local || !subject.active || !subject.isInGroup('wheel'))
        return;

    var program = action.lookup('program');
    if (program === '/usr/libexec/infinityos-upgrade-system' ||
        program === '/usr/libexec/infinityos-upgrade-release')
        return polkit.Result.YES;

    var command = action.lookup('command_line');
    if ((program === '/usr/bin/flatpak' &&
         command === '/usr/bin/flatpak update --system --noninteractive --assumeyes') ||
        (program === '/usr/bin/fwupdmgr' &&
         command === '/usr/bin/fwupdmgr update --assume-yes --no-reboot-check'))
        return polkit.Result.YES;
});
