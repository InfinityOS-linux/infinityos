+    // Send terminal controls to the Shell controller without changing tab focus.
+    fn setInfinityControl(key: []const u8, value: []const u8) void {
+        const argv = [_][]const u8{ "gsettings", "--schemadir", "/usr/share/gnome-shell/extensions/ghostty@infinityos.org/schemas", "set", "org.infinityos.GhosTTY", key, value };
+        var child = std.process.Child.init(&argv, std.heap.page_allocator);
+        child.stdin_behavior = .Ignore;
+        child.stdout_behavior = .Ignore;
+        child.stderr_behavior = .Ignore;
+        child.spawn() catch |err| {
+            log.warn("could not send InfinityTerminal control: {}", .{err});
+            return;
+        };
+        _ = child.wait() catch |err| {
+            log.warn("InfinityTerminal control failed: {}", .{err});
+            return;
+        };
+    }
+
+    fn btnInfinityPinToggled(button: *gtk.ToggleButton, self: *Self) callconv(.c) void {
+        if (!self.isInfinity()) return;
+        setInfinityControl("pinned", if (button.getActive() != 0) "true" else "false");
+    }
+
+    fn btnInfinityHide(_: *gtk.Button, self: *Self) callconv(.c) void {
+        if (!self.isInfinity()) return;
+        var buffer: [32]u8 = undefined;
+        const request = std.fmt.bufPrint(&buffer, "{d}", .{std.time.nanoTimestamp()}) catch return;
+        setInfinityControl("hide-request", request);
+    }
+
