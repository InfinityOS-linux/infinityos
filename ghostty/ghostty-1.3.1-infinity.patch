+    /// Add newly installed CLI tabs without closing existing terminal sessions.
+    pub fn actionRefreshCliTabs(
+        _: *gio.SimpleAction,
+        _: ?*glib.Variant,
+        self: *Self,
+    ) callconv(.c) void {
+        var node: ?*glib.List = @as(?*glib.List, self.as(gtk.Application).getWindows());
+        while (node) |entry| : (node = entry.f_next) {
+            const data = entry.f_data orelse continue;
+            const gtk_window: *gtk.Window = @ptrCast(@alignCast(data));
+            const window = gobject.ext.cast(Window, gtk_window) orelse continue;
+            window.ensureInfinityCliTabs();
+        }
