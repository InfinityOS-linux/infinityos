 const GlobalShortcuts = @import("global_shortcuts.zig").GlobalShortcuts;
 
 const log = std.log.scoped(.gtk_ghostty_application);
+
+fn infinityCliInstalled(name: []const u8) bool {
+    const home = std.posix.getenv("HOME") orelse return false;
+    var path_buf: [std.fs.max_path_bytes]u8 = undefined;
+    const local = std.fmt.bufPrint(&path_buf, "{s}/.local/bin/{s}", .{ home, name }) catch return false;
+    if (std.fs.accessAbsolute(local, .{})) |_| return true else |_| {}
+    const system = std.fmt.bufPrint(&path_buf, "/usr/bin/{s}", .{name}) catch return false;
+    if (std.fs.accessAbsolute(system, .{})) |_| return true else |_| {}
+    return false;
+}
 
