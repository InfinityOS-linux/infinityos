+        // Infinity's persistent CLI tabs use Ghostty's renderer and tab view.
+        if (std.mem.eql(u8, self.getConfig().get().class orelse "", "com.infinityos.GhosTTY")) {
+            var first = true;
+            if (infinityCliInstalled("codex")) {
+                win.newTabForWindow(parent, .{
+                    .command = .{ .shell = "zsh -ic 'codex; exec zsh'" },
+                    .title = "Codex CLI",
+                    .pinned = true,
+                });
+                first = false;
+            }
+            if (infinityCliInstalled("claude")) {
+                win.newTabForWindow(if (first) parent else null, .{
+                    .command = .{ .shell = "zsh -ic 'claude; exec zsh'" },
+                    .title = "Claude CLI",
+                    .pinned = true,
+                });
+                first = false;
+            }
+            // Keep one shell tab available even when CLI tabs are present.
+            win.newTabForWindow(if (first) parent else null, .{ .pinned = true });
+        } else {
+            win.newTabForWindow(parent, .{
+                .command = overrides.command,
+                .working_directory = overrides.working_directory,
+                .title = overrides.title,
+            });
+        }
 
