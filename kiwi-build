#!/bin/bash

# Simple wrapper to call kiwi properly for image builds
# Author: Neal Gompa <ngompa@fedoraproject.org>

set -eu -o pipefail

kiwibuildsh="$(basename "$0")"
kiwibuild_scriptdir="$(dirname "$0")"

usage() {
	echo >&2 "usage: $kiwibuildsh [--kiwi-description-dir=DIR] [--kiwi-file=FILE] [--isolated] --output-dir=DIR --image-type=TYPE --image-profile=PROFILE [--image-release=RELEASEID] [--debug]"
	echo >&2 "   eg: $kiwibuildsh --kiwi-description-dir=/var/tmp/desc --kiwi-file=config.kiwi --output-dir=/var/tmp/work --image-type=oem --image-profile=Cloud-Base-Generic --image-release=0 --debug"
	echo >&2 "   eg: $kiwibuildsh --output-dir=/var/tmp/work --image-type=oem --image-profile=Cloud-Base-Generic"
	echo >&2 "   eg: $kiwibuildsh --isolated --output-dir=/var/tmp/work --image-type=oem --image-profile=Cloud-Base-Generic"
	exit 255
}

optTemp=$(getopt --options '+k:,f:,i,b:,o:,t:,p:,r:,d,h' --longoptions 'kiwi-description-dir:,kiwi-file:,isolated,kiwi-bundle-format:,output-dir:,image-type:,image-profile:,image-release:,debug,help' --name "$kiwibuildsh" -- "$@")
eval set -- "$optTemp"
unset optTemp

output_dir=
image_type=
image_profile=
image_release=
debug=
kiwi_isolated=
# For compatibility with older scripts where these did not exist
kiwi_description_dir="./"
kiwi_file="InfinityOS.kiwi"
kiwi_bundle_format=
kiwibuild_extra_args=

while true; do
	case "$1" in
		-i|--isolated) kiwi_isolated=1; shift ;;
		-k|--kiwi-description-dir) kiwi_description_dir="$2" ; shift 2 ;;
		-f|--kiwi-file) kiwi_file="$2" ; shift 2 ;;
		-b|--kiwi-bundle-format) kiwi_bundle_format="$2" ; shift 2 ;;
		-o|--output-dir) output_dir="$2" ; shift 2 ;;
		-t|--image-type) image_type="$2" ; shift 2 ;;
		-p|--image-profile) image_profile="$2" ; shift 2 ;;
		-r|--image-release) image_release="$2" ; shift 2 ;;
		-d|--debug) debug="--debug" ; shift ;;
		-h|--help) usage ;;
		--) shift ; break ;;
	esac
done

# Capture arguments after --
kiwibuild_extra_args=("$@")

if [ -z "$output_dir" ] || [ -z "$image_type" ] || [ -z "$image_profile" ] || [ -z "$kiwi_file" ]; then
	echo "Options not set!"
	usage
fi

if [ -z "$kiwi_bundle_format" ]; then
	# Set the bundle format after we know the profile
	kiwi_bundle_format=$("${kiwibuild_scriptdir}/scripts/infinityos-kiwi-bundle-format-generator" "${kiwi_file}" "${image_profile}")
fi

if [[ "$image_profile" == Infinity-GNOME-* ]]; then
	kiwibuild_repo=$(cd "$kiwibuild_scriptdir" && pwd)
	if [[ "$(cd "$kiwi_description_dir" && pwd)" != "$kiwibuild_repo" || "$kiwi_file" != InfinityOS.kiwi ]]; then
		echo 'Infinity OS images must use this repository and InfinityOS.kiwi.' >&2
		exit 1
	fi
	kiwibuild_revision=$("$kiwibuild_repo/scripts/infinityos-source-revision" "$kiwibuild_repo")
	kiwibuild_stage=$(mktemp -d)
	trap 'rm -rf "$kiwibuild_stage"' EXIT
	git -c "safe.directory=$kiwibuild_repo" -C "$kiwibuild_repo" archive --format=tar "$kiwibuild_revision" | tar -xf - -C "$kiwibuild_stage"
	"$kiwibuild_stage/scripts/verify-gnome-extension-contracts" "$kiwibuild_stage"
	# Run behavior contracts from the same commit that KIWI will install.
	command -v node >/dev/null || { echo 'Node.js is required for Infinity OS behavior contracts.' >&2; exit 1; }
	node --test "$kiwibuild_stage"/tests/*.test.mjs
	install -d "$kiwibuild_stage/root/usr/share/infinityos"
	for spec in "$kiwibuild_stage"/packages/*/*.spec; do
		[[ -f "$spec" ]] || continue
		basename "$(dirname "$spec")"
	done | sort -u > "$kiwibuild_stage/root/usr/share/infinityos/required-rpms"
	printf '%s\n' "$kiwibuild_revision" > "$kiwibuild_stage/root/usr/share/infinityos/build-revision"
	kiwi_description_dir="$kiwibuild_stage"
	echo "Building Infinity OS from source revision $kiwibuild_revision"
fi

if [ "$image_type" = "iso" ]; then
	# Add parameters for embedded ISO IDs
	kiwibuild_iso_extra_args=$("${kiwibuild_scriptdir}/scripts/infinityos-live-iso-label-generator" "${kiwi_file}" "${image_profile}" --output-kiwi-args)
	kiwibuild_extra_args="${kiwibuild_extra_args:+${kiwibuild_extra_args}} ${kiwibuild_iso_extra_args}"
fi

kiwibuild_prepared_root=
if [[ "$image_profile" == Infinity-GNOME-Live && "$image_type" == iso && -z "$kiwi_isolated" ]]; then
	# A reused root can contain partial RPM transactions or old Infinity apps.
	# Prepare only a new directory and let KIWI install the image packages.
	if [[ -e "${output_dir}-build" ]]; then
		echo "Refusing an existing Infinity OS build directory: ${output_dir}-build" >&2
		exit 1
	fi
	"${kiwibuild_scriptdir}/scripts/prepare-infinity-bootstrap" "${output_dir}-build/build/image-root"
	kiwibuild_prepared_root=--allow-existing-root
fi

set +e
if [ -z "$kiwi_isolated" ]; then
	kiwi-ng ${debug} --type="${image_type}" --profile="${image_profile}" --kiwi-file="${kiwi_file}" --color-output system build --description "${kiwi_description_dir}" --target-dir "${output_dir}-build" ${kiwibuild_prepared_root:+$kiwibuild_prepared_root} ${kiwibuild_extra_args:+${kiwibuild_extra_args}}
else
	kiwi-ng ${debug} --type="${image_type}" --profile="${image_profile}" --kiwi-file="${kiwi_file}" --color-output system boxbuild --box universal -- --description "${kiwi_description_dir}" --target-dir "${output_dir}-build" ${kiwibuild_extra_args:+${kiwibuild_extra_args}}
fi
kiwi_status=$?
set -e

if [ "$kiwi_status" = 0 ] && [ "$image_type" = oem ] && [ "$image_profile" = Infinity-GNOME-Disk ]; then
	for image in "${output_dir}-build"/*.raw; do
		[ -f "$image" ] || { echo "Infinity OS RAW disk was not produced" >&2; exit 1; }
		"${kiwibuild_scriptdir}/scripts/finalize-infinity-disk" "$image" "$kiwibuild_revision"
	done
fi

if [ "$kiwi_status" = 0 ] && [ "$image_type" = iso ] && [ "$image_profile" = Infinity-GNOME-Live ]; then
	for image in "${output_dir}-build"/*.iso; do
		[ -f "$image" ] || { echo "Infinity OS ISO was not produced" >&2; exit 1; }
		"${kiwibuild_scriptdir}/scripts/verify-infinity-iso" "$image" "$kiwibuild_revision"
	done
fi

if [ "${kiwi_status}" = "0" ] && [ -n "$image_release" ]; then
	kiwi-ng ${debug} result bundle --bundle-format="${kiwi_bundle_format}" --target-dir "${output_dir}-build" --bundle-dir "${output_dir}" --id="${image_release}"
fi
exit $kiwi_status
