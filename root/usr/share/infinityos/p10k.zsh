# A compact purple Powerlevel10k prompt for Infinity OS.
typeset -g POWERLEVEL9K_MODE=ascii
typeset -g POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(os_icon dir vcs newline prompt_char)
typeset -g POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(status command_execution_time time)
typeset -g POWERLEVEL9K_PROMPT_ADD_NEWLINE=false
typeset -g POWERLEVEL9K_LEFT_SEGMENT_SEPARATOR=''
typeset -g POWERLEVEL9K_LEFT_SUBSEGMENT_SEPARATOR=''
typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR=''
typeset -g POWERLEVEL9K_RIGHT_SUBSEGMENT_SEPARATOR=''
typeset -g POWERLEVEL9K_OS_ICON_CONTENT_EXPANSION='∞'
typeset -g POWERLEVEL9K_OS_ICON_FOREGROUND=255
typeset -g POWERLEVEL9K_OS_ICON_BACKGROUND=54
typeset -g POWERLEVEL9K_DIR_FOREGROUND=255
typeset -g POWERLEVEL9K_DIR_BACKGROUND=60
typeset -g POWERLEVEL9K_SHORTEN_STRATEGY=truncate_to_unique
typeset -g POWERLEVEL9K_VCS_FOREGROUND=141
typeset -g POWERLEVEL9K_VCS_BACKGROUND=236
typeset -g POWERLEVEL9K_VCS_BRANCH_ICON=' '
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VIINS_FOREGROUND=141
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_VIINS_FOREGROUND=203
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VIINS_CONTENT_EXPANSION='❯'
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_VIINS_CONTENT_EXPANSION='❯'
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND='#2b1836'
typeset -g POWERLEVEL9K_STATUS_ERROR_PIPE_FOREGROUND='#2b1836'
typeset -g POWERLEVEL9K_STATUS_ERROR_SIGNAL_FOREGROUND='#2b1836'
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND='#40374d'
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_THRESHOLD=3
typeset -g POWERLEVEL9K_TIME_FOREGROUND='#40374d'
typeset -g POWERLEVEL9K_TIME_FORMAT='%D{%H:%M}'
(( ! $+functions[p10k] )) || p10k reload
