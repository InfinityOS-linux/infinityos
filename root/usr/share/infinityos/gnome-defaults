[org/gnome/shell]
enabled-extensions=['blur-my-shell@aunetx', 'windowIsReady_Remover@nunofarruca@gmail.com', 'appindicatorsupport@rgcjonas.gmail.com']

[org/gnome/desktop/wm/preferences]
button-layout=':minimize,maximize,close'

[org/gnome/desktop/wm/keybindings]
switch-applications=[]
switch-applications-backward=[]
switch-windows=['<Alt>Tab']
switch-windows-backward=['<Shift><Alt>Tab']

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/infinityos/infinityos-light.png'
picture-uri-dark='file:///usr/share/backgrounds/infinityos/infinityos-dark.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/infinityos/infinityos-dark.png'

[org/gnome/desktop/interface]
accent-color='purple'
