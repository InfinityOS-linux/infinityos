[org/gnome/shell]
enabled-extensions=['blur-my-shell@aunetx', 'windowIsReady_Remover@nunofarruca@gmail.com', 'appindicatorsupport@rgcjonas.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com']

[org/gnome/shell/extensions/user-theme]
name='Orchis-Purple-Dark-Compact'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'

[org/gnome/desktop/wm/keybindings]
switch-applications=@as []
switch-applications-backward=@as []
switch-windows=['<Alt>Tab']
switch-windows-backward=['<Shift><Alt>Tab']

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/infinityos/infinityos-light.png'
picture-uri-dark='file:///usr/share/backgrounds/infinityos/infinityos-dark.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/infinityos/infinityos-dark.png'

[org/gnome/desktop/interface]
accent-color='purple'
gtk-theme='Orchis-Purple-Dark-Compact'
color-scheme='prefer-dark'
