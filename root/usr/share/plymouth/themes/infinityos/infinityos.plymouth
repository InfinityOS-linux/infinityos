[Plymouth Theme]
Name=Infinity OS
Description=Infinity OS startup screen
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/infinityos
HorizontalAlignment=.5
VerticalAlignment=.5
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
Transition=none
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
