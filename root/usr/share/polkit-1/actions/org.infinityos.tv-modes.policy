<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.infinityos.tv-modes.manage">
    <description>Manage Infinity OS TV modes</description>
    <description xml:lang="pl">Zarządzaj trybami TV w Infinity OS</description>
    <message>Authenticate to change Infinity OS TV modes</message>
    <message xml:lang="pl">Uwierzytelnij się, aby zmienić tryby TV w Infinity OS</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/infinityos-tv-control</annotate>
  </action>
</policyconfig>
