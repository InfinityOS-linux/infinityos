[Unit]
Description=Prepare persistent Infinity OS Btrfs backups
Requires=infinityos-snapper-setup.service
After=infinityos-snapper-setup.service infinityos-liveinstall-boot-setup.service local-fs.target
RequiresMountsFor=/boot/efi
ConditionKernelCommandLine=!rd.live.image
ConditionPathExists=!/run/initramfs/live
ConditionPathExists=|!/var/lib/infinityos/backups-ready
ConditionPathIsMountPoint=|!/.snapshots

[Service]
Type=oneshot
ExecCondition=/usr/bin/findmnt --noheadings --types btrfs --mountpoint /
ExecStart=/usr/libexec/infinityos-backups-setup

[Install]
WantedBy=multi-user.target
