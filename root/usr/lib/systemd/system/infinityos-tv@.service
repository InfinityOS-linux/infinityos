[Unit]
Description=Infinity OS %i TV session
After=multi-user.target systemd-logind.service kmsconvt@tty1.service
Requires=systemd-logind.service
# KMSCon also owns the VT and DRM device on installations using a graphical console.
Conflicts=display-manager.service getty@tty1.service kmsconvt@tty1.service

[Service]
Type=simple
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=LIBSEAT_BACKEND=logind
SyslogIdentifier=infinityos-tv
ExecStartPre=+/usr/libexec/infinityos-tv-control consume %i
# PAM may grant ambient capabilities which Bubblewrap refuses to inherit.
ExecStart=/usr/bin/setpriv --ambient-caps=-all --inh-caps=-all -- /usr/libexec/infinityos-tv-run %i
ExecStopPost=+/usr/libexec/infinityos-tv-return-desktop
