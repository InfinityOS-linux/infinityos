[Unit]
Description=Finish Infinity OS rEFInd setup after installation
After=local-fs.target
ConditionPathIsMountPoint=/boot/efi
ConditionPathExists=/etc/infinityos/liveinstall-boot-pending
ConditionPathExists=!/etc/infinityos/liveinstall-refind

[Service]
Type=oneshot
ExecStart=/usr/libexec/infinityos-liveinstall-boot-setup

[Install]
WantedBy=multi-user.target
