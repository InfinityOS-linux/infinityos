#!/usr/bin/python3
"""Add the shared, one-shot Horizon animation to Anaconda's GTK welcome page."""
from pathlib import Path
import sys


def patch(source):
    marker = "        this.content.set_child(statusPage);"
    if "// Infinity OS Horizon" in source:
        return source
    if source.count(marker) != 1 or "iconName: 'infinityos-welcome'" not in source:
        raise ValueError("Unsupported Anaconda welcome layout")
    return "import Gdk from 'gi://Gdk?version=4.0';\nimport Graphene from 'gi://Graphene';\n" + source.replace(marker, '''        // Infinity OS Horizon: reuse boot frames and stop on the final logo.
        statusPage.set_icon_name(null);
        const logo = new Gtk.Picture({can_shrink: true, content_fit: Gtk.ContentFit.CONTAIN});
        const logoFrame = new Gtk.AspectFrame({ratio: 8 / 3, obey_child: false, child: logo});
        const layout = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL,
            valign: Gtk.Align.CENTER, margin_top: 24, margin_bottom: 24});
        layout.append(logoFrame);
        layout.append(statusPage);
        const welcome = new Adw.Clamp({maximum_size: 600, tightening_threshold: 500,
            margin_start: 24, margin_end: 24, child: layout});
        let started = null;
        let previousFrame = -1;
        logo.add_tick_callback((_widget, clock) => {
            started ??= clock.get_frame_time();
            const frame = Math.min(89, Math.floor((clock.get_frame_time() - started) / 1000000 * 15));
            if (frame !== previousFrame) {
                const texture = Gdk.Texture.new_from_filename(
                    `/usr/share/plymouth/themes/infinityos/horizon-${frame}.png`);
                // Crop only empty vertical margins; keep the shared boot frames.
                const snapshot = new Gtk.Snapshot();
                const bounds = new Graphene.Rect();
                bounds.init(0, -45, 480, 270);
                snapshot.append_texture(texture, bounds);
                const size = new Graphene.Size();
                size.init(480, 180);
                logo.set_paintable(snapshot.to_paintable(size));
                previousFrame = frame;
            }
            return frame < 89;
        });
''' + '        this.content.set_child(welcome);')


if __name__ == '__main__':
    path = Path(sys.argv[1])
    source = path.read_text()
    # Keep the GJS executable's interpreter line first.
    first, rest = source.split('\n', 1)
    path.write_text(first + '\n' + patch(rest))
