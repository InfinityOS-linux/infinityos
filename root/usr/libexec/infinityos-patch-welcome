#!/usr/bin/python3
"""Add the shared, one-shot Horizon animation to Anaconda's GTK welcome page."""
from pathlib import Path
import sys


def patch(source):
    marker = "        this.content.set_child(statusPage);"
    if "// Infinity OS Horizon" in source:
        return source
    if source.count(marker) != 1 or "iconName: 'infinityos-welcome'" not in source:
        raise ValueError("Unsupported Anaconda welcome layout")
    return "import Gdk from 'gi://Gdk?version=4.0';\n" + source.replace(marker, '''        // Infinity OS Horizon: reuse boot frames and stop on the final logo.
        statusPage.add_css_class('infinity-horizon');
        const logoStyle = new Gtk.CssProvider();
        logoStyle.load_from_string('.infinity-horizon .icon { -gtk-icon-size: 224px; }');
        Gtk.StyleContext.add_provider_for_display(this.get_display(), logoStyle,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
        let started = null;
        let previousFrame = -1;
        statusPage.add_tick_callback((_widget, clock) => {
            started ??= clock.get_frame_time();
            const frame = Math.min(89, Math.floor((clock.get_frame_time() - started) / 1000000 * 15));
            if (frame !== previousFrame) {
                statusPage.set_paintable(Gdk.Texture.new_from_filename(
                    `/usr/share/plymouth/themes/infinityos/horizon-${frame}.png`));
                previousFrame = frame;
            }
            return frame < 89;
        });
''' + marker)


if __name__ == '__main__':
    path = Path(sys.argv[1])
    source = path.read_text()
    # Keep the GJS executable's interpreter line first.
    first, rest = source.split('\n', 1)
    path.write_text(first + '\n' + patch(rest))
