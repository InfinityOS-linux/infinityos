#!/usr/bin/env bash
set -euo pipefail

esp=${1:-/boot/efi}
cmdline_file=${2:-/etc/kernel/cmdline}
ready_marker=${3:-/var/lib/infinityos/backups-ready}
tv_modes=${4:-/etc/infinityos/tv-modes}
next_mode=${5:-/etc/infinityos/tv-next-mode}
config="$esp/EFI/refind/refind.conf"
fallback_config="$esp/EFI/BOOT/refind.conf"
[[ -d $esp/EFI/refind && -s $cmdline_file ]] || exit 1
install -d "$esp/EFI/BOOT"
options=$(<"$cmdline_file")
[[ -n $options && $options != *'"'* && $options != *$'\n'* ]] || exit 1
for splash_option in loglevel=3 rd.udev.log_level=3 systemd.show_status=false vt.global_cursor_default=0; do
	[[ " $options " == *" $splash_option "* ]] || options+=" $splash_option"
done

if [[ -e $ready_marker ]]; then
	read -r -a args <<< "$options"
	filtered=()
	for arg in "${args[@]}"; do
		[[ $arg == rootflags=subvol=root ]] || filtered+=("$arg")
	done
	options=${filtered[*]}
fi

shopt -s nullglob
kernels=("$esp"/os/vmlinuz-*)
(( ${#kernels[@]} )) || { echo 'No kernel on the EFI partition' >&2; exit 1; }
versions=()
for kernel in "${kernels[@]}"; do
	version=${kernel##*/vmlinuz-}
	[[ $version =~ ^[A-Za-z0-9._+-]+$ ]] || continue
	[[ -s $esp/os/initramfs-$version.img ]] || continue
	versions+=("$version")
done
(( ${#versions[@]} )) || { echo 'No matching kernel and initramfs' >&2; exit 1; }
IFS=$'\n' versions=($(printf '%s\n' "${versions[@]}" | sort -Vr))
unset IFS

default='Infinity OS'
if [[ -s $next_mode ]]; then
	requested=
	read -r requested < "$next_mode" || true
	case $requested in
		esde) title='EmulationStation'; icon=os_infinityos_esde.png ;;
		steam) title='Steam Big Picture'; icon=os_infinityos_steam.png ;;
		*) title=; icon= ;;
	esac
	if [[ -n $title && -s $tv_modes/$requested &&
	      -s $esp/EFI/refind/infinity-theme/icons/$icon ]]; then
		default=$title
	fi
fi

tmp=$(mktemp "$esp/EFI/refind/.refind.conf.XXXXXX")
fallback_tmp=$(mktemp "$esp/EFI/BOOT/.refind.conf.XXXXXX")
trap 'rm -f "$tmp" "$fallback_tmp"' EXIT
{
	printf 'timeout 5\ndefault_selection "%s"\nscanfor manual\ninclude infinity-theme/theme.conf\n\n' "$default"
	for version in "${versions[@]}"; do
		if [[ $version == "${versions[0]}" ]]; then
			title='Infinity OS'
		else
			title="Infinity OS ($version)"
		fi
		printf 'menuentry "%s" {\n' "$title"
		printf '    loader /os/vmlinuz-%s\n' "$version"
		printf '    icon /EFI/refind/infinity-theme/icons/os_infinityos.png\n'
		printf '    initrd /os/initramfs-%s.img\n' "$version"
		printf '    options "%s"\n' "$options"
		printf '}\n\n'
	done
	version=${versions[0]}
	for mode in esde steam; do
		[[ -s $tv_modes/$mode ]] || continue
		case $mode in
			esde) title='EmulationStation'; icon=os_infinityos_esde.png ;;
			steam) title='Steam Big Picture'; icon=os_infinityos_steam.png ;;
		esac
		[[ -s $esp/EFI/refind/infinity-theme/icons/$icon ]] || continue
		printf 'menuentry "%s" {\n' "$title"
		printf '    loader /os/vmlinuz-%s\n' "$version"
		printf '    icon /EFI/refind/infinity-theme/icons/%s\n' "$icon"
		printf '    initrd /os/initramfs-%s.img\n' "$version"
		printf '    options "%s systemd.unit=infinityos-tv@%s.target"\n' "$options" "$mode"
		printf '}\n\n'
	done
	backup_options=()
	read -r -a args <<< "$options"
	for arg in "${args[@]}"; do
		case $arg in
			rhgb|quiet|loglevel=*|rd.udev.log_level=*|systemd.show_status=*|vt.global_cursor_default=*|systemd.unit=*|plymouth.enable=*) ;;
			*) backup_options+=("$arg") ;;
		esac
	done
	printf 'menuentry "Backups (Btrfs)" {\n'
	printf '    loader /os/vmlinuz-%s\n' "$version"
	printf '    icon /EFI/refind/infinity-theme/icons/os_infinityos_recovery.png\n'
	printf '    initrd /os/initramfs-%s.img\n' "$version"
	printf '    options "%s systemd.unit=infinityos-backups.target plymouth.enable=0"\n' "${backup_options[*]}"
	printf '}\n'
} > "$tmp"
chmod 0644 "$tmp"
if [[ ! -f $config ]] || ! cmp -s "$tmp" "$config"; then
	mv -f "$tmp" "$config"
fi
cp "$config" "$fallback_tmp"
if [[ ! -f $fallback_config ]] || ! cmp -s "$fallback_tmp" "$fallback_config"; then
	mv -f "$fallback_tmp" "$fallback_config"
fi
