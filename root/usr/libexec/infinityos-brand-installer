#!/usr/bin/python3
"""Apply the InfinityOS live installer changes to Fedora 45 Anaconda WebUI 90."""

import gzip
import json
import re
import sys
from pathlib import Path


WEBUI = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/usr/share/cockpit/anaconda-webui")
MESSAGE = "When reboot begins, remove the installation USB before the next boot."


def replace_once(content, old, new, label):
    count = content.count(old)
    if count != 1:
        raise RuntimeError(f"Anaconda WebUI 90 {label} changed: expected one match, got {count}")
    return content.replace(old, new)


def replace_once_or_present(content, old, new, label):
    old_count = content.count(old)
    new_count = content.count(new)
    if old_count == 1 and new_count == 0:
        return content.replace(old, new)
    if old_count == 0 and new_count == 1:
        return content
    raise RuntimeError(
        f"Anaconda WebUI 90 {label} changed: expected one original or branded match, "
        f"got {old_count} original and {new_count} branded"
    )


version = (WEBUI / "VERSION.txt").read_text(encoding="utf-8").strip()
if version != "90":
    raise RuntimeError(f"Unsupported Anaconda WebUI version: {version}")
for asset in ("infinityos-installer.css", "infinityos-installer-audio.js",
              "infinityos-installer-mark.svg", "infinityos-installer-mascot.png",
              "infinityos-installer-music.mp3",
              "infinityos-plex-regular.woff2", "infinityos-plex-medium.woff2",
              "infinityos-plex-semibold.woff2", "infinityos-plex-bold.woff2",
              *(f"infinityos-step-{name}.svg" for name in (
                  "language", "time", "method", "storage", "accounts", "review"))):
    if not (WEBUI / asset).is_file() or not (WEBUI / asset).stat().st_size:
        raise RuntimeError(f"Missing InfinityOS installer asset: {asset}")

bundle = WEBUI / "index.js.gz"
source = gzip.decompress(bundle.read_bytes()).decode("utf-8")
if MESSAGE not in source:
    source = replace_once(
        source,
        'y.format(jo("To begin using $0, reboot your system."),m.PRETTY_NAME)',
        '(t=>t==="' + MESSAGE + '"?jo("Reboot to installed system")+" · "+'
        'jo("Remove")+" USB":t)(jo("' + MESSAGE + '"))',
        "completion message",
    )
    source = replace_once(
        source,
        'key:"reboot",onClick:kw},jo("Reboot")',
        'key:"reboot",onClick:kw},jo("Reboot to installed system")',
        "reboot button",
    )
    source = replace_once(
        source,
        'key:"reboot",onClick:kw},jo("Reboot to installed system")',
        'key:"reboot",onClick:()=>y.spawn(["systemctl","reboot"],'
        '{superuser:"require"})},jo("Reboot to installed system")',
        "success action",
    )

step_labels = (
    ('this.id="anaconda-screen-language",this.label=Zz("Welcome")',
     'this.id="anaconda-screen-language",this.label=Zz("Language and layout")'),
    ('this.id="anaconda-screen-date-time",this.label=q$("Date and time")',
     'this.id="anaconda-screen-date-time",this.label=q$("Time and region")'),
    ('this.id="anaconda-screen-method",this.label=Uet("Installation method")',
     'this.id="anaconda-screen-method",this.label=Uet("Installation destination")'),
    ('this.id="anaconda-screen-storage-configuration",this.label=hJ("Storage configuration")',
     'this.id="anaconda-screen-storage-configuration",this.label=hJ("Security")'),
    ('this.id="anaconda-screen-accounts",this.label=iet("Create Account")',
     'this.id="anaconda-screen-accounts",this.label=iet("User")'),
    ('this.id="anaconda-screen-review",this.label=Pz("Review and install")',
     'this.id="anaconda-screen-review",this.label=Pz("Summary")'),
    ('label:cot("Storage configuration"),steps:[r]',
     'label:cot("Security"),steps:[r]'),
)
for original, branded in step_labels:
    source = replace_once_or_present(source, original, branded, "step label")

polish = WEBUI / "po.pl.js.gz"
locale = gzip.decompress(polish.read_bytes()).decode("utf-8").rstrip()
translations = {
    MESSAGE: "Gdy rozpocznie się restart, wyjmij USB przed ponownym uruchomieniem systemu.",
    "Language and layout": "Język i układ",
    "Time and region": "Czas i region",
    "Installation destination": "Miejsce instalacji",
    "Security": "Bezpieczeństwo",
    "User": "Użytkownik",
    "Summary": "Podsumowanie",
}
missing = [key for key in translations if not re.search(r'"' + re.escape(key) + r'"\s*:', locale)]
if missing:
    tail = '\n});'
    if not locale.endswith(tail):
        raise RuntimeError("Anaconda WebUI Polish catalog format changed")
    locale = locale[:-len(tail)].rstrip()
    if not locale.endswith(']'):
        raise RuntimeError("Anaconda WebUI Polish catalog is incomplete")
    locale += ''.join(
        ',\n ' + json.dumps(key, ensure_ascii=False) + ': [null, '
        + json.dumps(translations[key], ensure_ascii=False) + ']'
        for key in missing
    ) + tail
quit_translation = re.compile(r'("Quit"\s*:\s*\[\s*null,\s*")(?:\\.|[^"\\])*("\s*\])')
locale, count = quit_translation.subn(r'\1Zakończ\2', locale)
if count != 1:
    raise RuntimeError(f"Anaconda WebUI Polish Quit translation changed: expected one match, got {count}")
quit_title_translation = re.compile(
    r'("Quit installer\?"\s*:\s*\[\s*null,\s*")(?:\\.|[^"\\])*("\s*\])')
locale, count = quit_title_translation.subn(r'\1Zakończyć instalację?\2', locale)
if count != 1:
    raise RuntimeError(f"Anaconda WebUI Polish quit title changed: expected one match, got {count}")
bundle.write_bytes(gzip.compress(source.encode("utf-8"), compresslevel=9, mtime=0))
polish.write_bytes(gzip.compress(locale.encode("utf-8"), compresslevel=9, mtime=0))

index = WEBUI / "index.html"
html = index.read_text(encoding="utf-8")
if 'infinityos-installer.css' not in html:
    html = replace_once(html, '</head>',
                        '<link rel="stylesheet" href="infinityos-installer.css"></head>', "HTML head")
if 'infinityos-installer-audio.js' not in html:
    html = replace_once(html, '</head>',
                        '<script src="infinityos-installer-audio.js" defer></script></head>',
                        "audio controls")
index.write_text(html, encoding="utf-8")
