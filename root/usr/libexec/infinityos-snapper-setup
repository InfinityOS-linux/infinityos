#!/bin/bash
set -euo pipefail

[[ $(findmnt -n -o FSTYPE /) == btrfs ]] || {
    echo 'Snapper initialization requires an installed Btrfs root.' >&2; exit 1;
}
# A copied Live payload may retain the build-time SELinux context.
if command -v restorecon >/dev/null && [[ -e /etc/sysconfig/snapper ]]; then
    restorecon /etc/sysconfig/snapper
fi

if ! snapper -c root get-config >/dev/null 2>&1; then
	snapper -c root create-config -f btrfs /
fi

snapper -c root set-config \
	TIMELINE_CREATE=no \
	TIMELINE_CLEANUP=yes \
	TIMELINE_LIMIT_HOURLY=5 \
	TIMELINE_LIMIT_DAILY=7 \
	TIMELINE_LIMIT_WEEKLY=4 \
	TIMELINE_LIMIT_MONTHLY=3 \
	TIMELINE_LIMIT_YEARLY=0

install -d /var/lib/infinityos
touch /var/lib/infinityos/snapper-ready
