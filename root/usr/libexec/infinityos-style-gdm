#!/usr/bin/env bash
set -euo pipefail

# GDM draws #lockDialogGroup from GNOME Shell's theme resource. Its dconf
# desktop background keys do not change the greeter's plain grey backdrop.
theme=${1:-/usr/share/gnome-shell/gnome-shell-theme.gresource}
login_svg=${2:-/usr/share/backgrounds/infinityos/infinityos-login.svg}
login_resource=/org/gnome/shell/theme/infinityos-login.svg
[[ -f "$theme" ]] || { echo "Missing GNOME Shell theme: $theme" >&2; exit 1; }
[[ -f "$login_svg" ]] || { echo "Missing GDM background: $login_svg" >&2; exit 1; }
command -v gresource >/dev/null
command -v glib-compile-resources >/dev/null

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
list="$work/resources.list"
gresource list "$theme" > "$list"
[[ -s "$list" ]] || { echo 'Empty GNOME Shell theme resource' >&2; exit 1; }

{
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<gresources><gresource prefix="/">'
    while IFS= read -r resource; do
        [[ "$resource" =~ ^/org/gnome/shell/[a-zA-Z0-9._/-]+$ && "$resource" != *..* ]] || {
            echo "Unexpected GNOME Shell resource: $resource" >&2
            exit 1
        }
        relative=${resource#/}
        mkdir -p "$work/$(dirname "$relative")"
        gresource extract "$theme" "$resource" > "$work/$relative"
        printf '  <file compressed="true">%s</file>\n' "$relative"
    done < "$list"
    if ! grep -Fqx "$login_resource" "$list"; then
        printf '  <file compressed="true">%s</file>\n' "${login_resource#/}"
    fi
    printf '%s\n' '</gresource></gresources>'
} > "$work/theme.xml"

patched=0
changed=0
if ! cmp -s "$login_svg" "$work/${login_resource#/}"; then
    mkdir -p "$(dirname "$work/${login_resource#/}")"
    install -m 0644 "$login_svg" "$work/${login_resource#/}"
    changed=1
fi
for css in "$work"/org/gnome/shell/theme/gnome-shell-{dark,light}.css; do
    [[ -f "$css" ]] || continue
    grep -Fq '#lockDialogGroup' "$css" || {
        echo "Missing GDM backdrop selector: $css" >&2
        exit 1
    }
    if ! grep -Fq 'Infinity OS GDM background v2' "$css"; then
        sed '/\/\* Infinity OS GDM background:/,/^}/d' "$css" > "$css.updated"
        mv "$css.updated" "$css"
        cat >> "$css" <<'EOF'

/* Infinity OS GDM background v2: black with a faint bottom glow. */
#lockDialogGroup {
  background-color: #000000;
  background-image: url("resource:///org/gnome/shell/theme/infinityos-login.svg");
  background-size: cover;
  background-position: center;
}
EOF
        changed=1
    fi
    if ! grep -Fq 'Infinity OS session transition v1' "$css"; then
        cat >> "$css" <<'EOF'

/* Infinity OS session transition v1: cover the stage before the wallpaper appears. */
stage {
  background-color: #000000;
}
EOF
        changed=1
    fi
    patched=$((patched + 1))
done
[[ $patched -gt 0 ]] || { echo 'No supported GNOME Shell theme CSS found' >&2; exit 1; }
[[ $changed -eq 1 ]] || exit 0

glib-compile-resources "$work/theme.xml" --sourcedir="$work" --target="$work/theme.gresource"
while IFS= read -r resource; do
    gresource extract "$work/theme.gresource" "$resource" >/dev/null
done < "$list"

install -m 0644 "$work/theme.gresource" "$theme.infinityos-new"
mv -f "$theme.infinityos-new" "$theme"
if command -v restorecon >/dev/null; then restorecon "$theme"; fi
