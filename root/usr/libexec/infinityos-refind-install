#!/usr/bin/env bash
set -euo pipefail

esp=${1:-/boot/efi}
case $(uname -m) in
	x86_64) arch=x64; fallback=BOOTX64.EFI ;;
	aarch64) arch=aa64; fallback=BOOTAA64.EFI ;;
	*) echo 'Unsupported EFI architecture' >&2; exit 1 ;;
esac
root=${INFINITYOS_ROOT:-}

read_esp_partition() {
	esp_device=$(findmnt -n -M "$esp" -o SOURCE)
	esp_partuuid=$(lsblk -dnro PARTUUID "$esp_device")
	if [[ ! $esp_partuuid =~ ^[[:xdigit:]]{8}-([[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}|[[:xdigit:]]{2})$ ]]; then
		echo "Cannot identify the EFI partition at $esp." >&2
		return 1
	fi
}

# efibootmgr separates the human-readable label from the device path with a tab.
# Match the HD and File nodes together so the same loader on another ESP is safe.
matching_entries() {
	LC_ALL=C awk -F '\t' -v target="$(printf '%s' "$esp_partuuid" | tr '[:upper:]' '[:lower:]')" -v refind="$1" '
		NF == 2 && /^Boot[[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]][* ]/ {
			device = tolower($2)
			if (!match(device, /(^|\/)hd\([0-9]+,(gpt|mbr),[^,]+,[^)]*\)\/file\([^)]*\)/))
				next
			path = substr(device, RSTART, RLENGTH)
			hd = path
			sub(/^\/?hd\(/, "", hd)
			split(hd, fields, ",")
			partuuid = fields[3]
			if (fields[2] == "mbr") {
				sub(/^0x/, "", partuuid)
				partuuid = substr("00000000" partuuid, length(partuuid) + 1) sprintf("-%02x", fields[1])
			}
			if (partuuid != target)
				next
			sub(/^.*\/file\(/, "", path)
			sub(/\)$/, "", path)
			gsub(/\\/, "/", path)
			if (refind != "") {
				if (substr($1, 9, 1) == "*" && path == refind) {
					print toupper(substr($1, 5, 4))
					exit
				}
			} else if (path ~ /^\/efi\/(infinityos\/(shim|grub)|systemd\/systemd-boot)[^\/]*\.efi$/) {
				print toupper(substr($1, 5, 4))
			}
		}' <<< "$firmware_state"
}

if [[ ${2:-} == --remove-obsolete-entries ]]; then
	read_esp_partition
	firmware_state=$(efibootmgr -v)
	obsolete_entries=$(matching_entries '')
	while IFS= read -r entry; do
		[[ -n $entry ]] || continue
		efibootmgr -b "$entry" -B
	done <<< "$obsolete_entries"
	exit 0
fi

source=$root/usr/share/rEFInd/refind
theme=$root/usr/share/infinityos/refind-theme
[[ -s $source/refind_$arch.efi && -d $theme && -d $esp/EFI ]] || exit 1
install -d "$esp/EFI/refind/infinity-theme" "$esp/EFI/BOOT/infinity-theme"
cp -a "$theme/." "$esp/EFI/refind/infinity-theme/"
cp -a "$theme/." "$esp/EFI/BOOT/infinity-theme/"
install -m 0644 "$source/refind_$arch.efi" "$esp/EFI/refind/.refind_$arch.efi.tmp"
"$root/usr/libexec/infinityos-refind-short-labels" "$esp/EFI/refind/.refind_$arch.efi.tmp"
mv -f "$esp/EFI/refind/.refind_$arch.efi.tmp" "$esp/EFI/refind/refind_$arch.efi"
install -m 0644 "$source/refind_$arch.efi" "$esp/EFI/BOOT/.$fallback.tmp"
"$root/usr/libexec/infinityos-refind-short-labels" "$esp/EFI/BOOT/.$fallback.tmp"
mv -f "$esp/EFI/BOOT/.$fallback.tmp" "$esp/EFI/BOOT/$fallback"
gamepad=$root/usr/share/infinityos/efi-drivers
[[ -s $gamepad/$arch/UsbXbox360Dxe.efi && -s $gamepad/config.ini ]] || {
	echo 'Infinity OS UEFI gamepad driver is missing' >&2
	exit 1
}
install -d "$esp/EFI/refind/drivers_$arch" "$esp/EFI/BOOT/drivers_$arch" "$esp/EFI/Xbox360"
for destination in "$esp/EFI/refind/drivers_$arch" "$esp/EFI/BOOT/drivers_$arch"; do
	install -m 0644 "$gamepad/$arch/UsbXbox360Dxe.efi" "$destination/UsbXbox360Dxe.efi"
done
[[ -e $esp/EFI/Xbox360/config.ini ]] ||
	install -m 0644 "$gamepad/config.ini" "$esp/EFI/Xbox360/config.ini"

# EFI firmware sees the fallback path even when it forgets NVRAM entries.
[[ -s $esp/EFI/refind/refind_$arch.efi && -s $esp/EFI/BOOT/$fallback &&
   -s $esp/EFI/BOOT/infinity-theme/theme.conf &&
   -s $esp/EFI/BOOT/infinity-theme/icons/os_infinityos.png &&
   -s $esp/EFI/BOOT/infinity-theme/icons/os_infinityos_recovery.png &&
   -s $esp/EFI/BOOT/infinity-theme/icons/os_infinityos_esde.png &&
   -s $esp/EFI/BOOT/infinity-theme/icons/os_infinityos_steam.png ]]
if [[ ${2:-} == --activate ]]; then
	command -v efibootmgr >/dev/null
	read_esp_partition
	read_firmware_order() {
		firmware_state=$(efibootmgr -v)
		order=$(sed -n 's/^BootOrder:[[:space:]]*//p' <<< "$firmware_state" | tr '[:lower:]' '[:upper:]')
		if [[ -n $order && ! $order =~ ^[0-9A-F]{4}(,[0-9A-F]{4})*$ ]]; then
			echo "Invalid firmware BootOrder: $order" >&2
			return 1
		fi
	}
	refind_path="/efi/refind/refind_$arch.efi"
	read_firmware_order
	boot_entry=$(matching_entries "$refind_path")
	if [[ -z $boot_entry ]]; then
		disk=$(lsblk -dnro PKNAME "$esp_device")
		part=$(lsblk -dnro PARTN "$esp_device")
		[[ -n $disk && $part =~ ^[0-9]+$ ]] || exit 1
		# Create the variable without changing BootOrder until it has been cleaned.
		efibootmgr -C -d "/dev/$disk" -p "$part" -L 'Infinity OS rEFInd' -l "\\EFI\\refind\\refind_$arch.efi"
		read_firmware_order
		boot_entry=$(matching_entries "$refind_path")
	fi
	[[ -n $boot_entry ]] || { echo 'No active rEFInd entry found for the target EFI partition.' >&2; exit 1; }
	available_entries=$(printf '%s\n' "$firmware_state" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)[*[:space:]].*/\1/p' | tr '[:lower:]' '[:upper:]')
	new_order=$boot_entry
	if [[ -n $order ]]; then
		IFS=, read -r -a existing_entries <<< "$order"
		for existing in "${existing_entries[@]}"; do
			case ,$new_order, in *,$existing,*) continue ;; esac
			# Some firmware retains IDs after deleting their Boot#### variable.
			# efibootmgr rejects the entire order if any such reference survives.
			# Keep every defined entry in order, including other operating systems
			# and inactive devices; do not delete their firmware variables.
			if printf '%s\n' "$available_entries" | grep -Fxq "$existing"; then
				new_order+=",$existing"
			else
				echo "Ignoring stale BootOrder reference $existing (Boot$existing does not exist)." >&2
			fi
		done
	fi
	if [[ $new_order != "$order" ]]; then
		efibootmgr -o "$new_order"
	fi
fi
