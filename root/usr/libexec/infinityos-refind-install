#!/usr/bin/env bash
set -euo pipefail

esp=${1:-/boot/efi}
case $(uname -m) in
	x86_64) arch=x64; fallback=BOOTX64.EFI ;;
	aarch64) arch=aa64; fallback=BOOTAA64.EFI ;;
	*) echo 'Unsupported EFI architecture' >&2; exit 1 ;;
esac
root=${INFINITYOS_ROOT:-}
source=$root/usr/share/rEFInd/refind
theme=$root/usr/share/infinityos/refind-theme
[[ -s $source/refind_$arch.efi && -d $theme && -d $esp/EFI ]] || exit 1
install -d "$esp/EFI/refind/infinity-theme" "$esp/EFI/BOOT/infinity-theme"
cp -a "$theme/." "$esp/EFI/refind/infinity-theme/"
cp -a "$theme/." "$esp/EFI/BOOT/infinity-theme/"
install -m 0644 "$source/refind_$arch.efi" "$esp/EFI/refind/.refind_$arch.efi.tmp"
mv -f "$esp/EFI/refind/.refind_$arch.efi.tmp" "$esp/EFI/refind/refind_$arch.efi"
install -m 0644 "$source/refind_$arch.efi" "$esp/EFI/BOOT/.$fallback.tmp"
mv -f "$esp/EFI/BOOT/.$fallback.tmp" "$esp/EFI/BOOT/$fallback"

# EFI firmware sees the fallback path even when it forgets NVRAM entries.
[[ -s $esp/EFI/refind/refind_$arch.efi && -s $esp/EFI/BOOT/$fallback &&
   -s $esp/EFI/BOOT/infinity-theme/theme.conf &&
   -s $esp/EFI/BOOT/infinity-theme/icons/os_infinityos.png &&
   -s $esp/EFI/BOOT/infinity-theme/icons/os_infinityos_recovery.png ]]
if [[ ${2:-} == --activate ]]; then
	command -v efibootmgr >/dev/null
	esp_device=$(findmnt -n -M "$esp" -o SOURCE)
	disk=$(lsblk -nr -o PKNAME "$esp_device" | head -n 1)
	part=$(lsblk -nr -o PARTN "$esp_device" | head -n 1)
	[[ -n $disk && $part =~ ^[0-9]+$ ]] || exit 1
	boot_entry=$(efibootmgr | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\* Infinity OS rEFInd.*/\1/p' | head -n 1)
	if [[ -z $boot_entry ]]; then
		efibootmgr -c -d "/dev/$disk" -p "$part" -L 'Infinity OS rEFInd' -l "\\EFI\\refind\\refind_$arch.efi"
		boot_entry=$(efibootmgr | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\* Infinity OS rEFInd.*/\1/p' | head -n 1)
	fi
	[[ -n $boot_entry ]]
	order=$(efibootmgr | sed -n 's/^BootOrder: //p')
	[[ -n $order ]]
	new_order=$boot_entry
	IFS=, read -r -a existing_entries <<< "$order"
	for existing in "${existing_entries[@]}"; do
		[[ $existing == "$boot_entry" ]] || new_order+=",$existing"
	done
	efibootmgr -o "$new_order"
fi
