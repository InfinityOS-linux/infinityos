#!/usr/bin/env bash
# Run as root after a fresh installation and first reboot.
set -uo pipefail

failures=0
check() {
    local label=$1
    shift
    if "$@" >/dev/null 2>&1; then
        printf 'PASS  %s\n' "$label"
    else
        printf 'FAIL  %s\n' "$label"
        failures=$((failures + 1))
    fi
}

active_infinity_boot() {
    local current details
    current=$(efibootmgr | sed -n 's/^BootCurrent: //p') || return 1
    [[ $current =~ ^[0-9A-Fa-f]{4}$ ]] || return 1
    details=$(efibootmgr -v | grep -i "^Boot${current}\\*" | head -n 1) || return 1
    if grep -Eiq 'EFI[\\/]refind[\\/]refind_|EFI[\\/]BOOT[\\/]BOOT' <<< "$details"; then
        return 0
    fi
    # Some firmware records only the hard disk path. Its removable-media
    # fallback is the byte-identical rEFInd binary verified below.
    [[ $details == *'HD('* && $details != *'File('* ]]
}

if [[ $EUID -ne 0 ]]; then
    echo 'Run this installed-system audit with sudo.' >&2
    exit 2
fi

case $(uname -m) in
    aarch64) efi_arch=aa64 ;;
    x86_64) efi_arch=x64 ;;
    *) echo 'Unsupported architecture' >&2; exit 2 ;;
esac

check 'UEFI session' test -d /sys/firmware/efi
check 'Btrfs root' bash -c '[[ $(findmnt -n -o FSTYPE /) == btrfs ]]'
check 'EFI partition mounted' bash -c '[[ $(findmnt -n -M /boot/efi -o FSTYPE) == vfat ]]'
check 'rEFInd installation recorded' test -f /etc/infinityos/refind-installed
check 'rEFInd EFI binary' test -s "/boot/efi/EFI/refind/refind_${efi_arch}.efi"
check 'rEFInd fallback matches' cmp -s "/boot/efi/EFI/refind/refind_${efi_arch}.efi" "/boot/efi/EFI/BOOT/BOOT${efi_arch^^}.EFI"
check 'Infinity OS rEFInd entry' grep -Fq 'menuentry "Infinity OS"' /boot/efi/EFI/refind/refind.conf
check 'fallback rEFInd menu matches' cmp -s /boot/efi/EFI/refind/refind.conf /boot/efi/EFI/BOOT/refind.conf
check 'fallback rEFInd theme' test -s /boot/efi/EFI/BOOT/infinity-theme/theme.conf
check 'fallback Infinity OS icon' test -s /boot/efi/EFI/BOOT/infinity-theme/icons/os_infinityos.png
check 'fallback recovery icon' test -s /boot/efi/EFI/BOOT/infinity-theme/icons/os_infinityos_recovery.png
check 'active Infinity OS EFI entry' active_infinity_boot
check 'Snapper root configuration' test -f /etc/snapper/configs/root
check 'Btrfs backup setup' test -f /var/lib/infinityos/backups-ready
check 'Btrfs Backups rEFInd entry' grep -Fq 'menuentry "Backups (Btrfs)"' /boot/efi/EFI/refind/refind.conf
check 'obsolete EFI loaders absent' bash -c '[[ ! -e /boot/efi/EFI/infinityos && ! -e /boot/efi/EFI/systemd && ! -e /boot/efi/loader && ! -e /boot/grub2 ]]'
check 'obsolete loader maintenance masked' bash -c 'for unit in systemd-boot-update.service systemd-boot-clear-sysfail.service systemd-boot-random-seed.service systemd-bootctl.socket grub-boot-indeterminate.service; do [[ $(systemctl is-enabled "$unit") == masked ]] || exit 1; done'
check 'obsolete EFI loader packages absent' bash -c '! rpm -qa --qf "%{NAME}\n" | grep -Eq "^(grub2-efi-|grub2-pc($|-)|grub2-tools-efi$|shim-(aa64|ia32|x64)$|systemd-boot-unsigned$)"'
check 'Infinity OS desktop RPMs' rpm -q infinity-config infinity-setup infinity-terminal infinity-updater infinityos-shell-extensions
check 'Infinity OS GNOME defaults' test -f /usr/share/infinityos/gnome-defaults
check 'Infinity OS desktop wallpaper' test -s /usr/share/backgrounds/infinityos/infinityos-dark.png

if (( failures )); then
    printf '%s installed-system checks failed.\n' "$failures" >&2
    exit 1
fi
echo 'Installed Infinity OS boot, backups, applications and defaults are present.'
