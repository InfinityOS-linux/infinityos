#!/usr/bin/python3
"""Enable bundled desktop additions once without resetting existing preferences."""
import os
from pathlib import Path

EXTENSIONS = ('nowplay@LalaloyXyz', 'raccoonlauncher@shimafallah.github.io')
RETIRED_LOCKSCREEN = 'wack-lockscreen-clock@rinzler69-wastaken.github.com'

def with_extensions(enabled):
    return [*enabled, *(uuid for uuid in EXTENSIONS if uuid not in enabled)]

def without_launcher_conflict(shortcuts):
    return ['<Super><Alt>space' if key.lower() in ('<super>space', '<mod4>space') else key
            for key in shortcuts]

def main():
    from gi.repository import Gio
    marker = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'infinityos/desktop-additions-v1'
    shell = Gio.Settings.new('org.gnome.shell')
    enabled = list(shell.get_strv('enabled-extensions'))
    updated = enabled
    user_data = Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share'))
    if RETIRED_LOCKSCREEN in enabled and not (user_data / 'gnome-shell/extensions' / RETIRED_LOCKSCREEN).exists():
        updated = [uuid for uuid in enabled if uuid != RETIRED_LOCKSCREEN]

    first_run = not marker.exists()
    if first_run:
        keys = Gio.Settings.new('org.gnome.desktop.wm.keybindings')
        shortcuts = list(keys.get_strv('switch-input-source'))
        migrated = without_launcher_conflict(shortcuts)
        if migrated != shortcuts and not keys.set_strv('switch-input-source', migrated):
            return 1
        updated = with_extensions(updated)

    if updated != enabled and not shell.set_strv('enabled-extensions', updated):
        return 1
    if first_run or updated != enabled:
        Gio.Settings.sync()
    if first_run:
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.touch()
    return 0

if __name__ == '__main__':
    raise SystemExit(main())
