#!/usr/bin/python3
"""Mount user-selected local volumes in the GNOME session."""

import argparse
import fcntl
import logging
import os
import re
import sys
from collections import defaultdict
from pathlib import Path

from gi.repository import Gio, GLib


MOUNT_TIMEOUT_SECONDS = 20
SETTINGS_SCHEMA = "org.infinityos.automount"
UDISKS = "org.freedesktop.UDisks2"
UDISKS_PATH = "/org/freedesktop/UDisks2"
UDISKS_BLOCK = f"{UDISKS}.Block"
UDISKS_FILESYSTEM = f"{UDISKS}.Filesystem"
FSTAB_MKDIR = "X-mount.mkdir"


def fstab_record(uuid, filesystem):
    # UDisks can mount this entry after sign-in without asking again. The
    # session monitor checks for missing and duplicate UUIDs before mounting.
    options = ["noauto", "nofail", "nosuid", "nodev", FSTAB_MKDIR, "x-gvfs-show"]
    if filesystem in {"vfat", "exfat", "ntfs", "ntfs3"}:
        options.extend((f"uid={os.getuid()}", f"gid={os.getgid()}", "umask=077"))
    return {"fsname": f"UUID={uuid}".encode() + b"\0",
            "dir": f"/mnt/infinityos-{uuid}".encode() + b"\0",
            "type": b"auto\0", "opts": ",".join(options).encode() + b"\0",
            "freq": 0, "passno": 0}


def configure_fixed_volume(bus, uuid, enabled):
    if not re.fullmatch(r"[A-Za-z0-9-]{1,128}", uuid):
        raise ValueError("Invalid filesystem UUID.")
    objects, = bus.call_sync(UDISKS, UDISKS_PATH, "org.freedesktop.DBus.ObjectManager",
                             "GetManagedObjects", None, None, Gio.DBusCallFlags.NONE,
                             5000, None).unpack()
    matches = [(path, interfaces[UDISKS_BLOCK]) for path, interfaces in objects.items()
               if UDISKS_FILESYSTEM in interfaces and UDISKS_BLOCK in interfaces
               and interfaces[UDISKS_BLOCK].get("IdUUID") == uuid]
    if len(matches) != 1:
        raise ValueError("The selected filesystem is unavailable or its UUID is shared by another drive.")

    path, block = matches[0]
    record = fstab_record(uuid, block.get("IdType"))
    entries = [item for kind, item in block.get("Configuration", ()) if kind == "fstab"]
    owned = next((item for item in entries
                  if bytes(item.get("fsname", ())) == record["fsname"]
                  and bytes(item.get("dir", ())) == record["dir"]
                  and FSTAB_MKDIR.encode() in bytes(item.get("opts", ())).rstrip(b"\0").split(b",")), None)
    if enabled:
        if owned is not None or not block.get("HintSystem"):
            return
        if entries:
            raise ValueError("This drive already has a system mount entry. Manage it in Disks.")
        if block.get("HintIgnore") or block.get("CryptoBackingDevice", "/") != "/":
            raise ValueError("This drive cannot be mounted automatically without unlocking it.")
        method, item = "AddConfigurationItem", record
    else:
        if owned is None:
            return
        method, item = "RemoveConfigurationItem", owned

    fields = {key: GLib.Variant("i", item[key]) if key in ("freq", "passno")
              else GLib.Variant("ay", bytes(item[key])) for key in record}
    bus.call_sync(UDISKS, path, UDISKS_BLOCK, method,
                  GLib.Variant("((sa{sv})a{sv})", (("fstab", fields), {})),
                  None, Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 120000, None)


def set_automount(settings, uuid, enabled):
    if not settings.is_writable("volume-uuids"):
        raise ValueError("Automount preferences are locked.")
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    configure_fixed_volume(bus, uuid, enabled)
    selected = [value for value in settings.get_strv("volume-uuids") if value != uuid]
    if enabled:
        selected.append(uuid)
    if not settings.set_strv("volume-uuids", selected):
        raise ValueError("Could not save the Automount preference.")
    Gio.Settings.sync()


class Automount:
    def __init__(self, settings, monitor):
        self.settings = settings
        self.monitor = monitor
        self.attempted = set()
        self.pending = {}
        self.scan_source = 0
        monitor.connect("volume-added", self.queue_scan)
        monitor.connect("volume-removed", self.volume_removed)
        settings.connect("changed::volume-uuids", self.settings_changed)
        self.queue_scan()

    def queue_scan(self, *_args):
        if not self.scan_source:
            self.scan_source = GLib.idle_add(self.scan)

    def settings_changed(self, *_args):
        selected = set(self.settings.get_strv("volume-uuids"))
        for uuid, cancellable, _ in self.pending.values():
            if uuid not in selected:
                cancellable.cancel()
        self.queue_scan()

    def volume_removed(self, _monitor, volume):
        self.attempted.discard(volume)
        request = self.pending.get(volume)
        if request is not None:
            request[1].cancel()
        self.queue_scan()

    def scan(self):
        self.scan_source = 0
        selected = set(self.settings.get_strv("volume-uuids"))
        if not selected:
            self.attempted.clear()
            return GLib.SOURCE_REMOVE

        by_uuid = defaultdict(list)
        for volume in self.monitor.get_volumes():
            device = volume.get_identifier(Gio.VOLUME_IDENTIFIER_KIND_UNIX_DEVICE)
            uuid = volume.get_identifier(Gio.VOLUME_IDENTIFIER_KIND_UUID)
            if uuid in selected and device and device.startswith("/dev/"):
                by_uuid[uuid].append(volume)

        # Keep a manually unmounted drive unmounted until it is reconnected.
        self.attempted.intersection_update(volume for volumes in by_uuid.values() for volume in volumes)
        for uuid, volumes in by_uuid.items():
            if len(volumes) != 1:
                logging.warning("Skipping ambiguous volume UUID %s", uuid)
                continue
            volume = volumes[0]
            if volume in self.attempted or volume in self.pending:
                continue
            if volume.get_mount() is not None:
                self.attempted.add(volume)
            elif volume.can_mount():
                self.start_mount(volume, uuid)
        return GLib.SOURCE_REMOVE

    def start_mount(self, volume, uuid):
        cancellable = Gio.Cancellable()

        def timeout():
            self.pending[volume] = (uuid, cancellable, 0)
            logging.warning("Timed out mounting volume %s", uuid)
            cancellable.cancel()
            return GLib.SOURCE_REMOVE

        self.attempted.add(volume)
        timeout_id = GLib.timeout_add_seconds(MOUNT_TIMEOUT_SECONDS, timeout)
        self.pending[volume] = (uuid, cancellable, timeout_id)
        # A background mount must not ask the user to unlock or authorize a drive.
        volume.mount(Gio.MountMountFlags.NONE, None, cancellable, self.mount_finished, None)

    def mount_finished(self, volume, result, _user_data):
        uuid, _, timeout_id = self.pending.pop(volume)
        if timeout_id:
            GLib.source_remove(timeout_id)
        try:
            volume.mount_finish(result)
        except GLib.Error as error:
            if not any(error.matches(Gio.io_error_quark(), code) for code in (
                Gio.IOErrorEnum.CANCELLED, Gio.IOErrorEnum.ALREADY_MOUNTED
            )):
                logging.warning("Could not mount volume %s: %s", uuid, error.message)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--configure", nargs=2, metavar=("UUID", "on|off"))
    args = parser.parse_args()
    settings = Gio.Settings.new(SETTINGS_SCHEMA)
    if args.configure:
        uuid, mode = args.configure
        if mode not in ("on", "off"):
            parser.error("expected on or off")
        try:
            lock = Path(GLib.get_user_runtime_dir()) / "infinityos-automount.lock"
            with lock.open("a") as handle:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                set_automount(settings, uuid, mode == "on")
        except BlockingIOError:
            sys.exit("Another Automount change is still in progress.")
        except (GLib.Error, OSError, ValueError) as error:
            sys.exit(str(error))
    else:
        automount = Automount(settings, Gio.VolumeMonitor.get())
        GLib.MainLoop().run()
