#!/usr/bin/env bash
set -euo pipefail

extension=ghostty@infinityos.org
marker="$HOME/.local/state/infinityos-liveinst-terminal"
restore_terminal() {
    if gnome-extensions enable "$extension"; then
        rm -f "$marker"
    fi
}

if [[ ${1:-} == --restore-terminal ]]; then
    if [[ -f $marker ]]; then
        read -r installer_pid < "$marker"
        if ! kill -0 "$installer_pid" 2>/dev/null; then
            restore_terminal
        fi
    fi
    exit 0
fi

enabled=$(gnome-extensions list --enabled)
terminal_disabled=false
if grep -Fqx "$extension" <<< "$enabled"; then
    mkdir -p "${marker%/*}"
    printf '%s\n' "$$" > "$marker"
    gnome-extensions disable "$extension"
    terminal_disabled=true
fi

dim_marker=
cleanup() {
    [[ -z $dim_marker ]] || rm -f "$dim_marker"
    [[ $terminal_disabled == false ]] || restore_terminal
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    dim_marker="$XDG_RUNTIME_DIR/infinityos-liveinst-dim-$$"
    if touch "$dim_marker"; then
        sleep 0.3
    else
        dim_marker=
    fi
fi

liveinst "$@"
