#!/usr/bin/python3
"""Manage the two optional TV boot modes without touching user game data."""

import os
import pwd
import re
import subprocess
import sys
import tempfile
from pathlib import Path

STATE = Path("/etc/infinityos/tv-modes")
NEXT = Path("/etc/infinityos/tv-next-mode")
DROPINS = Path("/etc/systemd/system")
MODES = {"esde", "steam"}


def atomic_write(path, content, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(content)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def account(uid):
    if not uid.isdecimal() or int(uid) < 1000:
        raise ValueError("Select a regular user account")
    selected = pwd.getpwuid(int(uid))
    if not re.fullmatch(r"[a-z_][a-z0-9_-]*", selected.pw_name):
        raise ValueError("Unsupported account name")
    if not Path(selected.pw_dir).is_dir():
        raise ValueError("Account home directory is missing")
    caller = os.environ.get("PKEXEC_UID")
    if caller is not None and int(caller) != selected.pw_uid:
        raise PermissionError("Only your own account can be enabled")
    return selected


def installed_refind():
    return Path("/etc/infinityos/refind-installed").exists()


def refresh_boot_menu():
    if installed_refind():
        subprocess.run(["/usr/libexec/infinityos-refind-install"], check=True)
        subprocess.run(["/usr/libexec/infinityos-refind-config"], check=True)


def dropin(mode):
    return DROPINS / f"infinityos-tv@{mode}.service.d/account.conf"


def enable(mode, uid):
    selected = account(uid)
    state = STATE / mode
    configuration = dropin(mode)
    previous_state = state.read_bytes() if state.exists() else None
    previous_config = configuration.read_bytes() if configuration.exists() else None
    try:
        atomic_write(state, f"{selected.pw_uid}\n")
        atomic_write(configuration, f"[Service]\nUser={selected.pw_name}\nWorkingDirectory=~\n")
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        refresh_boot_menu()
    except Exception:
        if previous_state is None:
            state.unlink(missing_ok=True)
        else:
            atomic_write(state, previous_state.decode("ascii"))
        if previous_config is None:
            configuration.unlink(missing_ok=True)
        else:
            atomic_write(configuration, previous_config.decode("ascii"))
        subprocess.run(["systemctl", "daemon-reload"], check=False)
        try:
            refresh_boot_menu()
        except Exception:
            pass
        raise


def prepare_emulation(uid, root=Path("/emulation")):
    selected = account(uid)
    if root.is_symlink():
        raise ValueError("/emulation must be a directory, not a symlink")
    root.mkdir(mode=0o755, exist_ok=True)
    if not root.is_dir():
        raise ValueError("/emulation is not a directory")
    for name in ("roms", "bios"):
        path = root / name
        if path.is_symlink():
            raise ValueError(f"{path} must not be a symlink")
        if not path.exists():
            path.mkdir(mode=0o750)
            os.chown(path, selected.pw_uid, selected.pw_gid)
        if not path.is_dir() or path.stat().st_uid != selected.pw_uid:
            raise ValueError(f"{path} must belong to {selected.pw_name}")


def disable(mode):
    state = STATE / mode
    previous = state.read_bytes() if state.exists() else None
    caller = os.environ.get("PKEXEC_UID")
    if previous is not None and caller is not None and previous.decode("ascii").strip() != caller:
        raise PermissionError("This mode belongs to another account")
    state.unlink(missing_ok=True)
    if NEXT.exists() and NEXT.read_text(encoding="utf-8").strip() == mode:
        NEXT.unlink()
    try:
        refresh_boot_menu()
    except Exception:
        if previous is not None:
            atomic_write(state, previous.decode("ascii"))
        try:
            refresh_boot_menu()
        except Exception:
            pass
        raise
    dropin(mode).unlink(missing_ok=True)
    subprocess.run(["systemctl", "daemon-reload"], check=True)


def request_next(mode):
    state = STATE / mode
    if not state.is_file() or not dropin(mode).is_file():
        raise ValueError("This TV mode is not enabled")
    owner = state.read_text(encoding="ascii").strip()
    caller = os.environ.get("PKEXEC_UID")
    if caller is not None and caller != owner:
        raise PermissionError("This mode belongs to another account")
    previous = NEXT.read_bytes() if NEXT.exists() else None
    atomic_write(NEXT, f"{mode}\n", 0o600)
    try:
        subprocess.run(["systemctl", "reboot"], check=True)
    except Exception:
        if previous is None:
            NEXT.unlink(missing_ok=True)
        else:
            atomic_write(NEXT, previous.decode("ascii"), 0o600)
        raise


def consume(mode):
    if NEXT.is_file() and NEXT.read_text(encoding="ascii").strip() == mode:
        NEXT.unlink()


def main():
    if os.geteuid() != 0 or len(sys.argv) < 3 or sys.argv[2] not in MODES:
        raise SystemExit("Usage: infinityos-tv-control enable|disable|next|consume esde|steam [uid]")
    action, mode = sys.argv[1:3]
    if action == "enable" and len(sys.argv) == 4:
        enable(mode, sys.argv[3])
    elif action == "prepare" and mode == "esde" and len(sys.argv) == 4:
        prepare_emulation(sys.argv[3])
    elif action == "disable" and len(sys.argv) == 3:
        disable(mode)
    elif action == "next" and len(sys.argv) == 3:
        request_next(mode)
    elif action == "consume" and len(sys.argv) == 3:
        consume(mode)
    else:
        raise SystemExit("Invalid TV mode command")


if __name__ == "__main__":
    main()
