#!/usr/bin/bash
set -euo pipefail

case "$(uname -m)" in
    aarch64)
        asset=Proview-v1.19-linux-arm64.AppImage
        checksum=f27f9fd94694fb121e37067114cf59d2660b592ce77288d6c84d8c499537562f
        ;;
    x86_64)
        asset=Proview-v1.19-linux-amd64.AppImage
        checksum=5d334286d02a743bdad93513047323c73affbd0b3ff1ad68801ad7c4cd83be2a
        ;;
    *)
        echo "Unsupported Proview architecture: $(uname -m)" >&2
        exit 1
        ;;
esac

install -d -m 0755 /opt/proview
if [[ -f /opt/proview/Proview.AppImage ]] &&
    printf '%s  %s\n' "$checksum" /opt/proview/Proview.AppImage | sha256sum --check --status; then
    chmod 0755 /opt/proview/Proview.AppImage
    exit 0
fi
curl --fail --location --retry 3 --output /opt/proview/Proview.AppImage \
    "https://github.com/emanuelelongo/proview/releases/download/v1.19/$asset"
printf '%s  %s\n' "$checksum" /opt/proview/Proview.AppImage | sha256sum --check --status
chmod 0755 /opt/proview/Proview.AppImage
