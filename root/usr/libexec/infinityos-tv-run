#!/usr/bin/bash
set -euo pipefail

run_steam() {
    local started=$SECONDS status
    if gamescope -e -f -- "$@"; then
        return 0
    else
        status=$?
    fi
    if (( SECONDS - started >= 20 )); then
        return "$status"
    fi
    if ! command -v cage >/dev/null 2>&1; then
        echo "gamescope exited early ($status); Cage fallback is unavailable" >&2
        return "$status"
    fi
    echo "gamescope exited early ($status); trying Cage with software rendering" >&2
    WLR_RENDERER=pixman exec cage -- "$@"
}

case ${1:-} in
    esde)
        app="$HOME/.local/share/infinityos/tv/ES-DE.AppImage"
        [[ -x $app ]] || { echo "ES-DE is not installed for $USER" >&2; exit 1; }
        exec cage -- "$app"
        ;;
    steam)
        if [[ $(uname -m) == aarch64 ]]; then
            client="$HOME/.local/share/Steam/steamrtarm64/steam"
            [[ -x $client ]] || { echo 'Steam ARM64 is missing' >&2; exit 1; }
            run_steam "$client" -gamepadui
            exit $?
        fi
        if flatpak info --user com.valvesoftware.Steam >/dev/null 2>&1; then
            scope=--user
        elif flatpak info --system com.valvesoftware.Steam >/dev/null 2>&1; then
            scope=--system
        else
            echo 'Steam Flatpak is missing' >&2
            exit 1
        fi
        run_steam flatpak run "$scope" com.valvesoftware.Steam -gamepadui
        ;;
    *) echo 'Unknown TV mode' >&2; exit 2 ;;
esac
