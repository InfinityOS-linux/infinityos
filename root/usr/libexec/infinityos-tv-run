#!/usr/bin/bash
set -euo pipefail

run_steam() {
    local started status relaunches=0
    while true; do
        started=$SECONDS
        if dbus-run-session -- gamescope -e -f -- "$@"; then
            if (( SECONDS - started >= 20 )); then
                return 0
            fi
            # Steam can restart its launcher several times while updating.
            if (( relaunches < 5 )); then
                (( ++relaunches ))
                echo "Steam exited early; relaunching in TV mode ($relaunches/5)" >&2
                sleep 1
                continue
            fi
            echo 'Steam exited immediately after five relaunches' >&2
            status=1
        else
            status=$?
        fi
        if (( SECONDS - started >= 20 )); then
            return "$status"
        fi
        if ! command -v cage >/dev/null 2>&1; then
            echo "gamescope exited early ($status); Cage fallback is unavailable" >&2
            return "$status"
        fi
        echo "gamescope exited early ($status); trying Cage with software rendering" >&2
        WLR_RENDERER=pixman exec dbus-run-session -- cage -- "$@"
    done
}

case ${1:-} in
    esde)
        app="$HOME/.local/share/infinityos/tv/ES-DE.AppImage"
        [[ -x $app ]] || { echo "ES-DE is not installed for $USER" >&2; exit 1; }
        exec cage -- "$app"
        ;;
    steam)
        if [[ $(uname -m) == aarch64 ]]; then
            client="$HOME/.local/share/Steam/steamrtarm64/steam"
            [[ -x $client ]] || { echo 'Steam ARM64 is missing' >&2; exit 1; }
            run_steam "$client" -gamepadui -steamos3 -steampal -steamdeck
            exit $?
        fi
        if flatpak info --user com.valvesoftware.Steam >/dev/null 2>&1; then
            scope=--user
        elif flatpak info --system com.valvesoftware.Steam >/dev/null 2>&1; then
            scope=--system
        else
            echo 'Steam Flatpak is missing' >&2
            exit 1
        fi
        run_steam flatpak run "$scope" com.valvesoftware.Steam -gamepadui -steamos3 -steampal -steamdeck
        ;;
    *) echo 'Unknown TV mode' >&2; exit 2 ;;
esac
