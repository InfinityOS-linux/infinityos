#!/usr/bin/env bash
set -euo pipefail

# Anaconda's live payload creates kernel and BLS files without installing an
# EFI loader. The target is complete after both rEFInd boot choices exist.
[[ -d /sys/firmware/efi ]] || { echo 'UEFI boot is required' >&2; exit 1; }
[[ $(findmnt -n -o FSTYPE /) == btrfs ]] || { echo 'Infinity OS requires a Btrfs root' >&2; exit 1; }
[[ $(findmnt -n -M /boot/efi -o FSTYPE) == vfat ]] || { echo 'EFI system partition required' >&2; exit 1; }
secure_boot=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
if [[ -f $secure_boot && $(od -An -tu1 -j 4 -N 1 "$secure_boot" | tr -d ' ') == 1 ]]; then
    echo 'Disable Secure Boot before installing unsigned Infinity OS rEFInd media' >&2
    exit 1
fi
command -v snapper >/dev/null
command -v efibootmgr >/dev/null

source_entry=$(find /boot/loader/entries -maxdepth 1 -type f -name '*.conf' ! -name '*rescue*' | sort -V | tail -n 1)
[[ -n $source_entry ]] || { echo 'No installed kernel entry' >&2; exit 1; }
version=$(awk '$1 == "version" { print $2; exit }' "$source_entry")
[[ $version =~ ^[A-Za-z0-9._+-]+$ ]] || { echo 'Invalid kernel version' >&2; exit 1; }
kernel="/boot/vmlinuz-$version"
initrd="/boot/initramfs-$version.img"
[[ -s $kernel && -s $initrd ]] || { echo 'Kernel or initramfs is missing' >&2; exit 1; }
if [[ -s /etc/kernel/cmdline ]]; then
    options=$(</etc/kernel/cmdline)
else
    options=$(sed -n 's/^options[[:space:]]*//p' "$source_entry" | head -n 1)
    [[ -n $options ]] || { echo 'Kernel options are missing' >&2; exit 1; }
    install -d /etc/kernel
    printf '%s\n' "$options" > /etc/kernel/cmdline
fi

esp=/boot/efi
install -d "$esp/os" /etc/infinityos
install -m 0644 "$kernel" "$esp/os/.vmlinuz-$version.tmp"
install -m 0644 "$initrd" "$esp/os/.initramfs-$version.img.tmp"
mv -f "$esp/os/.vmlinuz-$version.tmp" "$esp/os/vmlinuz-$version"
mv -f "$esp/os/.initramfs-$version.img.tmp" "$esp/os/initramfs-$version.img"
/usr/libexec/infinityos-refind-install "$esp"
/usr/libexec/infinityos-refind-config "$esp"
grep -Fq 'menuentry "Backups (Btrfs)"' "$esp/EFI/refind/refind.conf"
/usr/libexec/infinityos-remove-obsolete-efi-loaders
# RPM erasure must not be able to remove the firmware fallback installed above.
/usr/libexec/infinityos-refind-install "$esp" --activate

# Only remove firmware-visible GRUB and systemd-boot paths after rEFInd is
# complete. The fallback EFI/BOOT path above survives lost NVRAM entries.
rm -rf "$esp/EFI/infinityos" "$esp/EFI/systemd" "$esp/loader" /boot/grub2

systemctl enable infinityos-snapper-setup.service infinityos-backups-setup.service \
    infinityos-backups-entry.service infinityos-backups-entry.path \
    snapper-timeline.timer snapper-cleanup.timer

touch /etc/infinityos/liveinstall-refind /etc/infinityos/refind-installed
rm -f /etc/infinityos/liveinstall-boot-pending
