#!/usr/bin/python3
"""Tint Kora's system icons purple while leaving application logos alone."""

import re
import xml.etree.ElementTree as ET

try:
    import gi
    gi.require_version("Rsvg", "2.0")
    from gi.repository import Rsvg
except (ImportError, ValueError):
    Rsvg = None
import sys
from pathlib import Path


SECTIONS = ("actions", "animations", "categories", "devices", "emblems",
            "emotes", "mimetypes", "panel", "places", "status")
FOLDER_COLORS = ("#443456", "#645394", "#dbc7ff")
TINTED_COLORS = set(FOLDER_COLORS) | {
    f"#{round(level * .45):02x}{round(level * .38):02x}{round(level * .67):02x}"
    for level in range(150, 256)
}
COLOR = re.compile(
    r'(?P<property>(?<![\w-])(?:fill|stroke|stop-color|flood-color|color)\s*[:=]\s*["\']?)'
    r'(?P<value>\#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\b|rgba?\([^)]*\))',
    re.IGNORECASE,
)


def tint(match, section):
    value = match.group("value")
    if value.startswith("#") and value[:7].lower() in TINTED_COLORS:
        return match.group()
    alpha = ""
    if value.startswith("#"):
        digits = value[1:]
        if len(digits) in (3, 4):
            digits = "".join(char * 2 for char in digits)
        red, green, blue = (int(digits[index:index + 2], 16) for index in (0, 2, 4))
        alpha = digits[6:]
    else:
        numbers = [part.strip() for part in re.split(r"[,\s/]+", value[value.index("(") + 1:-1]) if part]
        if len(numbers) < 3:
            return match.group()
        try:
            red, green, blue = (round(float(number.rstrip("%")) * (2.55 if number.endswith("%") else 1))
                                for number in numbers[:3])
        except ValueError:
            return match.group()
        if len(numbers) > 3:
            alpha = numbers[3]
    if f"#{red:02x}{green:02x}{blue:02x}" in TINTED_COLORS:
        return match.group()
    brightness = min(255, max(150, red, green, blue))
    purple = f"#{round(brightness * .45):02x}{round(brightness * .38):02x}{round(brightness * .67):02x}"
    if min(red, green, blue) >= 225 or (section == "mimetypes" and
        match.group("property").strip().startswith(("fill", "stroke")) and brightness >= 175):
        purple = FOLDER_COLORS[2]
    if value.startswith("#"):
        return match.group("property") + purple + alpha.lower()
    if alpha:
        return match.group("property") + f"rgba({int(purple[1:3],16)}, {int(purple[3:5],16)}, {int(purple[5:7],16)}, {alpha})"
    return match.group("property") + purple




def restore_file_paints(svg):
    """Recover the original paints before upgrading the first contrast pass."""
    if 'data-infinity-glyph-contrast="white-v1"' not in svg:
        return svg
    tree = ET.fromstring(svg)
    for node in tree.iter():
        style = node.get("style", "")
        while re.search(r";(?:fill|stroke):(?:#ffffff|#443456)(?:[0-9a-f]{2})?$", style):
            style = style.rsplit(";", 1)[0]
        if "style" in node.attrib:
            node.set("style", style)
    tree.attrib.pop("data-infinity-glyph-contrast", None)
    return ET.tostring(tree, encoding="unicode")

def white_file_glyphs(svg):
    """Keep document tiles purple, with white symbols and contrasting cutouts."""
    if Rsvg is None:
        return svg
    tree = ET.fromstring(svg)
    if tree.get("data-infinity-glyph-contrast") == "white-v2":
        return svg
    viewbox = tree.get("viewBox", "").split()
    if len(viewbox) != 4:
        return svg
    viewport = Rsvg.Rectangle()
    viewport.x, viewport.y, viewport.width, viewport.height = map(float, viewbox)
    shapes = []

    def collect(node, inherited=None):
        tag = node.tag.rsplit("}", 1)[-1]
        if tag in {"defs", "clipPath", "mask", "linearGradient", "radialGradient", "filter"}:
            return
        paints = dict(inherited or {"fill": "#000000", "stroke": "none"})
        for key in ("fill", "stroke"):
            if key in node.attrib:
                paints[key] = node.get(key)
        for key, value in re.findall(r"(?:^|;)\s*(fill|stroke)\s*:\s*([^;]+)", node.get("style", "")):
            paints[key] = value.strip()
        if tag in {"path", "rect", "circle", "ellipse", "polygon", "polyline", "text", "use"}:
            if not node.get("id"):
                node.set("id", f"infinity-glyph-{len(shapes)}")
            shapes.append((node, paints))
        for child in node:
            collect(child, paints)

    collect(tree)
    handle = Rsvg.Handle.new_from_data(ET.tostring(tree))
    measured = []
    for node, paints in shapes:
        valid, _ink, bounds = handle.get_geometry_for_layer("#" + node.get("id"), viewport)
        if valid:
            measured.append((node, paints, bounds))
    area = viewport.width * viewport.height
    backgrounds = {id(node) for node, _paints, box in measured
                   if box.width * box.height >= area * 0.45}
    if not backgrounds:
        return svg
    dark_symbols = []
    for node, paints, box in measured:
        if id(node) in backgrounds:
            continue
        overrides = []
        for key, value in paints.items():
            gradient = value.startswith("url(")
            if not gradient and not re.fullmatch(r"#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?", value):
                continue
            dark = gradient or max(int(value[i:i + 2], 16) for i in (1, 3, 5)) < 190
            # White details inside an earlier dark symbol become purple cutouts;
            # captions outside the symbol remain white on the document tile.
            inset = (not dark or gradient) and any(
                box.x >= outer.x - 0.01 and box.y >= outer.y - 0.01
                and box.x + box.width <= outer.x + outer.width + 0.01
                and box.y + box.height <= outer.y + outer.height + 0.01
                for outer in dark_symbols)
            color = "#443456" if inset else "#ffffff"
            overrides.append(f"{key}:{color}")
            if key == "fill" and dark and not inset:
                dark_symbols.append(box)
        if overrides:
            overrides.extend(["opacity:1", "fill-opacity:1", "stroke-opacity:1"])
            node.set("style", node.get("style", "").rstrip(";") + ";" + ";".join(overrides))
    # Group opacity multiplies child opacity; clear it for foreground-only groups.
    for group in tree.iter():
        if group.tag.rsplit("}", 1)[-1] == "g" and not any(id(child) in backgrounds for child in group.iter()):
            group.set("style", group.get("style", "").rstrip(";") + ";opacity:1;fill-opacity:1;stroke-opacity:1")
    tree.set("data-infinity-glyph-contrast", "white-v2")
    ET.register_namespace("", "http://www.w3.org/2000/svg")
    ET.register_namespace("xlink", "http://www.w3.org/1999/xlink")
    return ET.tostring(tree, encoding="unicode") + "\n"

def trash_icon(full):
    paper = '<path d="m19 18 5-5 5 4 4-7 5 7 6-3 2 10H19Z" fill="#dbc7ff"/>' if full else ""
    return ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">'
            '<path d="m12 18 5 35a7 7 0 0 0 7 6h16a7 7 0 0 0 7-6l5-35Z" fill="#645394"/>'
            '<ellipse cx="32" cy="18" rx="20" ry="7" fill="#443456"/>' + paper +
            '<path id="infinity-trash-detail" d="M23 29v20m9-20v20m9-20v20" fill="none" '
            'stroke="#dbc7ff" stroke-width="2" stroke-linecap="round" opacity=".95"/></svg>')


def main(root):
    for section in SECTIONS:
        for path in (root / section).rglob("*.svg"):
            if path.is_symlink() or not path.is_file():
                continue
            original = path.read_text(encoding="utf-8")
            if 'data-infinity-glyph-contrast="white-v2"' in original:
                continue
            if section == "places" and (path.stem.startswith("folder") or path.stem in {"user-home", "user-desktop"}):
                continue
            if section in {"places", "status"} and "scalable" in path.parts and path.name in {"user-trash.svg", "user-trash-full.svg"}:
                updated = trash_icon(path.stem.endswith("-full"))
            else:
                source = restore_file_paints(original) if section == "mimetypes" else original
                updated = COLOR.sub(lambda match: tint(match, section), source)
                if section == "mimetypes":
                    updated = white_file_glyphs(updated)
            if updated != original:
                path.write_text(updated, encoding="utf-8")


if __name__ == "__main__":
    main(Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/usr/share/icons/kora"))
