#!/usr/bin/python3
"""Tint Kora's system icons purple while leaving application logos alone."""

import re
import sys
from pathlib import Path


SECTIONS = ("actions", "animations", "categories", "devices", "emblems",
            "emotes", "mimetypes", "panel", "places", "status")
FOLDER_COLORS = ("#443456", "#645394", "#dbc7ff")
TINTED_COLORS = set(FOLDER_COLORS) | {
    f"#{round(level * .45):02x}{round(level * .38):02x}{round(level * .67):02x}"
    for level in range(150, 256)
}
COLOR = re.compile(
    r'(?P<property>(?<![\w-])(?:fill|stroke|stop-color|flood-color|color)\s*[:=]\s*["\']?)'
    r'(?P<value>\#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\b|rgba?\([^)]*\))',
    re.IGNORECASE,
)


def tint(match, section):
    value = match.group("value")
    if value.startswith("#") and value[:7].lower() in TINTED_COLORS:
        return match.group()
    alpha = ""
    if value.startswith("#"):
        digits = value[1:]
        if len(digits) in (3, 4):
            digits = "".join(char * 2 for char in digits)
        red, green, blue = (int(digits[index:index + 2], 16) for index in (0, 2, 4))
        alpha = digits[6:]
    else:
        numbers = [part.strip() for part in re.split(r"[,\s/]+", value[value.index("(") + 1:-1]) if part]
        if len(numbers) < 3:
            return match.group()
        try:
            red, green, blue = (round(float(number.rstrip("%")) * (2.55 if number.endswith("%") else 1))
                                for number in numbers[:3])
        except ValueError:
            return match.group()
        if len(numbers) > 3:
            alpha = numbers[3]
    if f"#{red:02x}{green:02x}{blue:02x}" in TINTED_COLORS:
        return match.group()
    brightness = min(255, max(150, red, green, blue))
    purple = f"#{round(brightness * .45):02x}{round(brightness * .38):02x}{round(brightness * .67):02x}"
    if min(red, green, blue) >= 225 or (section == "mimetypes" and
        match.group("property").strip().startswith(("fill", "stroke")) and brightness >= 175):
        purple = FOLDER_COLORS[2]
    if value.startswith("#"):
        return match.group("property") + purple + alpha.lower()
    if alpha:
        return match.group("property") + f"rgba({int(purple[1:3],16)}, {int(purple[3:5],16)}, {int(purple[5:7],16)}, {alpha})"
    return match.group("property") + purple


def trash_icon(full):
    paper = '<path d="m19 18 5-5 5 4 4-7 5 7 6-3 2 10H19Z" fill="#dbc7ff"/>' if full else ""
    return ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">'
            '<path d="m12 18 5 35a7 7 0 0 0 7 6h16a7 7 0 0 0 7-6l5-35Z" fill="#645394"/>'
            '<ellipse cx="32" cy="18" rx="20" ry="7" fill="#443456"/>' + paper +
            '<path id="infinity-trash-detail" d="M23 29v20m9-20v20m9-20v20" fill="none" '
            'stroke="#dbc7ff" stroke-width="2" stroke-linecap="round" opacity=".95"/></svg>')


def main(root):
    for section in SECTIONS:
        for path in (root / section).rglob("*.svg"):
            if path.is_symlink() or not path.is_file():
                continue
            original = path.read_text(encoding="utf-8")
            if section == "places" and (path.stem.startswith("folder") or path.stem in {"user-home", "user-desktop"}):
                continue
            if section in {"places", "status"} and "scalable" in path.parts and path.name in {"user-trash.svg", "user-trash-full.svg"}:
                updated = trash_icon(path.stem.endswith("-full"))
            else:
                updated = COLOR.sub(lambda match: tint(match, section), original)
            if updated != original:
                path.write_text(updated, encoding="utf-8")


if __name__ == "__main__":
    main(Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/usr/share/icons/kora"))
