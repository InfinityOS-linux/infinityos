#!/usr/bin/env bash
set -euo pipefail

image=${1:?Pass the Infinity OS RAW disk image}
script_dir=$(cd "$(dirname "$0")" && pwd)
revision=${2:-$("$script_dir/infinityos-source-revision")}
mountpoint=$(mktemp -d)
efi_mountpoint=$(mktemp -d)
loopdev=
cleanup() {
	if mountpoint -q "$efi_mountpoint"; then umount "$efi_mountpoint"; fi
	if mountpoint -q "$mountpoint"; then umount "$mountpoint"; fi
	if [[ -n $loopdev ]]; then losetup -d "$loopdev"; fi
	rmdir "$mountpoint"
	rmdir "$efi_mountpoint"
}
trap cleanup EXIT

loopdev=$(losetup --find --show --partscan "$image")
udevadm settle
partition="${loopdev}p2"
[[ $(blkid -s LABEL -o value "$partition") == infinityos ]] || {
	echo "Expected the Infinity OS Btrfs root in partition 2" >&2
	exit 1
}
mount -o subvol=root "$partition" "$mountpoint"
"$script_dir/../root/usr/libexec/infinityos-verify-build-root" "$mountpoint" "$revision"
# KIWI creates the Btrfs root subvolume with 0700, which blocks non-root services.
chmod 0755 "$mountpoint"
[[ $(stat -c %a "$mountpoint") == 755 ]]

# The custom KIWI bootloader leaves EFI setup to this finalizer. Use the
# Btrfs UUID and the known root subvolume, then copy each kernel/initramfs.
mount "${loopdev}p1" "$efi_mountpoint"
root_uuid=$(blkid -s UUID -o value "$partition")
[[ $root_uuid =~ ^[A-Fa-f0-9-]{36}$ ]] || { echo 'Missing Btrfs UUID' >&2; exit 1; }
install -d "$mountpoint/etc/kernel" "$mountpoint/etc/infinityos" "$efi_mountpoint/os"
printf 'root=UUID=%s rootflags=subvol=root rw rhgb quiet\n' "$root_uuid" > "$mountpoint/etc/kernel/cmdline"

copied=0
for kernel in "$mountpoint"/boot/vmlinuz-*; do
    [[ -s $kernel && $kernel != *rescue* ]] || continue
    version=${kernel##*/vmlinuz-}
    [[ $version =~ ^[A-Za-z0-9._+-]+$ ]] || exit 1
    initramfs="$mountpoint/boot/initramfs-$version.img"
    [[ -s $initramfs ]] || { echo "Missing initramfs $version" >&2; exit 1; }
    install -m 0644 "$kernel" "$efi_mountpoint/os/vmlinuz-$version"
    install -m 0644 "$initramfs" "$efi_mountpoint/os/initramfs-$version.img"
    cmp "$kernel" "$efi_mountpoint/os/vmlinuz-$version"
    cmp "$initramfs" "$efi_mountpoint/os/initramfs-$version.img"
    copied=$((copied + 1))
done
(( copied )) || { echo 'No bootable Infinity OS kernel' >&2; exit 1; }

INFINITYOS_ROOT=$mountpoint "$script_dir/../root/usr/libexec/infinityos-refind-install" "$efi_mountpoint"
"$script_dir/../root/usr/libexec/infinityos-refind-config" \
    "$efi_mountpoint" "$mountpoint/etc/kernel/cmdline" "$mountpoint/var/lib/infinityos/backups-ready"
grep -Fq 'menuentry "Backups (Btrfs)"' "$efi_mountpoint/EFI/refind/refind.conf"
cmp "$efi_mountpoint/EFI/refind/refind.conf" "$efi_mountpoint/EFI/BOOT/refind.conf"
# No KIWI loader is expected on the finished EFI partition.
rm -rf "$efi_mountpoint/EFI/systemd" "$efi_mountpoint/loader"
"$script_dir/../root/usr/libexec/infinityos-remove-obsolete-efi-loaders" "$mountpoint"
rm -rf "$mountpoint/boot/grub2" "$efi_mountpoint/EFI/infinityos"
systemctl --root="$mountpoint" mask --force systemd-boot-update.service \
    systemd-boot-clear-sysfail.service systemd-boot-random-seed.service \
    systemd-bootctl.socket grub-boot-indeterminate.service
touch "$mountpoint/etc/infinityos/refind-installed"
echo "Verified Infinity OS rEFInd disk from source revision $revision"
