#!/usr/bin/env bash
set -euo pipefail

image=${1:?Pass the Infinity OS RAW disk image}
script_dir=$(cd "$(dirname "$0")" && pwd)
revision=${2:-$("$script_dir/infinityos-source-revision")}
mountpoint=$(mktemp -d)
efi_mountpoint=$(mktemp -d)
loopdev=
cleanup() {
	if mountpoint -q "$efi_mountpoint"; then umount "$efi_mountpoint"; fi
	if mountpoint -q "$mountpoint"; then umount "$mountpoint"; fi
	if [[ -n $loopdev ]]; then losetup -d "$loopdev"; fi
	rmdir "$mountpoint"
	rmdir "$efi_mountpoint"
}
trap cleanup EXIT

loopdev=$(losetup --find --show --partscan "$image")
udevadm settle
partition="${loopdev}p2"
[[ $(blkid -s LABEL -o value "$partition") == infinityos ]] || {
	echo "Expected the Infinity OS Btrfs root in partition 2" >&2
	exit 1
}
mount -o subvol=root "$partition" "$mountpoint"
"$script_dir/../root/usr/libexec/infinityos-verify-build-root" "$mountpoint" "$revision"
# KIWI creates the Btrfs root subvolume with 0700, which blocks non-root services.
chmod 0755 "$mountpoint"
[[ $(stat -c %a "$mountpoint") == 755 ]]

# A reused prepared root may contain rescue images for an older kernel. KIWI
# can otherwise pair that rescue initramfs with the newest kernel on the ESP.
mount "${loopdev}p1" "$efi_mountpoint"
for entry in "$efi_mountpoint"/loader/entries/*.conf; do
	[[ -f $entry ]] || continue
	linux=$(awk '$1 == "linux" { print $2; exit }' "$entry")
	[[ $linux == os/vmlinuz-* ]] || continue
	version=${linux#os/vmlinuz-}
	initramfs="initramfs-${version}.img"
	[[ -s "$mountpoint/boot/$initramfs" ]] || {
		echo "Missing initramfs for kernel $version" >&2
		exit 1
	}
	install -m 0644 "$mountpoint/boot/$initramfs" "$efi_mountpoint/os/$initramfs"
	sed -i "s|^initrd .*|initrd os/$initramfs|" "$entry"
	grep -Fxq "initrd os/$initramfs" "$entry"
	cmp "$mountpoint/boot/$initramfs" "$efi_mountpoint/os/$initramfs"
done
echo "Verified Infinity OS disk from source revision $revision"
