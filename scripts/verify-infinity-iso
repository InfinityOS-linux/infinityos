#!/usr/bin/env bash
set -euo pipefail

iso=${1:?Usage: verify-infinity-iso IMAGE.iso}
script_dir=$(cd "$(dirname "$0")" && pwd)
revision=${2:-$("$script_dir/infinityos-source-revision")}
[[ -f "$iso" ]] || { echo "ISO not found: $iso" >&2; exit 1; }

checkisomd5 "$iso"

mountpoint=$(mktemp -d)
rootpoint=$(mktemp -d)
cleanup() {
    if mountpoint -q "$rootpoint"; then
        umount "$rootpoint"
    fi
    if mountpoint -q "$mountpoint"; then
        umount "$mountpoint"
    fi
    rmdir "$rootpoint"
    rmdir "$mountpoint"
}
trap cleanup EXIT

mount -o loop,ro "$iso" "$mountpoint"
[[ -f "$mountpoint/LiveOS/squashfs.img" ]] || {
    echo "Live filesystem missing from ISO: $iso" >&2
    exit 1
}
fsck.erofs --extract "$mountpoint/LiveOS/squashfs.img"
mount -t erofs -o loop,ro "$mountpoint/LiveOS/squashfs.img" "$rootpoint"
"$script_dir/verify-selinux-labels" "$rootpoint"
"$script_dir/../root/usr/libexec/infinityos-verify-build-root" "$rootpoint" "$revision"
"$script_dir/verify-gnome-extension-contracts" "$rootpoint"
grep -qx 'IsFinal=True' "$rootpoint/.buildstamp" || {
    echo 'Installer still identifies Infinity OS as a test release' >&2
    exit 1
}
for required in \
    usr/libexec/infinityos-audit-install \
    usr/libexec/infinityos-liveinstall-boot-setup \
    usr/libexec/infinityos-refind-install \
    usr/libexec/infinityos-refind-config \
    usr/libexec/infinityos-remove-obsolete-efi-loaders \
    usr/libexec/infinityos-live-power \
    etc/skel/.config/autostart/infinityos-live-power.desktop \
    usr/lib/systemd/system/infinityos-liveinstall-boot-setup.service \
    usr/lib/kernel/install.d/96-infinityos-esp.install \
    usr/share/anaconda/interactive-defaults.ks; do
    [[ -f "$rootpoint/$required" ]] || {
        echo "Installed boot setup missing from ISO: $required" >&2
        exit 1
    }
done
[[ -x "$rootpoint/usr/libexec/infinityos-live-power" ]] || {
    echo 'Live power settings script is not executable' >&2
    exit 1
}
grep -Fqx 'Exec=liveinst' \
    "$rootpoint/usr/share/applications/liveinst.desktop" || {
    echo 'Live installer does not keep the GNOME dock active' >&2
    exit 1
}
[[ -f "$rootpoint/etc/infinityos/liveinstall-boot-pending" ]] || {
    echo 'Installed boot retry marker missing from ISO' >&2
    exit 1
}
grep -Fqx '%post --erroronfail --log=/var/log/infinityos-boot-install.log' \
    "$rootpoint/usr/share/anaconda/interactive-defaults.ks" || {
    echo 'Installer can silently finish without rEFInd' >&2
    exit 1
}
grep -Fqx '/usr/libexec/infinityos-liveinstall-boot-setup' \
    "$rootpoint/usr/share/anaconda/interactive-defaults.ks" || {
    echo 'Installer is missing the rEFInd conversion command' >&2
    exit 1
}
if grep -Fqx 'bootloader --location=none' "$rootpoint/usr/share/anaconda/interactive-defaults.ks"; then
    echo 'Anaconda cannot create the required EFI partition' >&2
    exit 1
fi
if [[ $(uname -m) == x86_64 ]]; then
    grep -Fq '/usr/libexec/infinityos-install-nvidia /mnt/sysroot' \
        "$rootpoint/usr/share/anaconda/interactive-defaults.ks" || {
        echo 'Installer is missing the NVIDIA hardware detection hook' >&2
        exit 1
    }
fi
grep -Fqx 'mkdir -p "$EFI_HOME"' "$rootpoint/usr/sbin/gen_grub_cfgstub" || {
    echo 'Installer cannot create the Infinity OS EFI directory' >&2
    exit 1
}
case $(uname -m) in
    x86_64) efi_arch=x64; fallback=BOOTX64.EFI ;;
    aarch64) efi_arch=aa64; fallback=BOOTAA64.EFI ;;
esac
rpm --root "$rootpoint" -q rEFInd "rEFInd-unsigned-$efi_arch" >/dev/null || {
    echo 'rEFInd package missing from ISO' >&2
    exit 1
}
if rpm --root "$rootpoint" -q systemd-boot-unsigned >/dev/null 2>&1; then
    echo 'systemd-boot package remained in the live system' >&2
    exit 1
fi
[[ ! -e $mountpoint/boot/grub2 && ! -e $mountpoint/boot/$(uname -m)/loader/grub2 ]] || {
    echo 'Published ISO still contains the GRUB menu' >&2
    exit 1
}
efi_images=$(mktemp -d)
efi_mount=$(mktemp -d)
cleanup_efi() {
    mountpoint -q "$efi_mount" && umount "$efi_mount"
    rm -rf "$efi_images"
    rmdir "$efi_mount"
}
trap 'cleanup_efi; cleanup' EXIT
xorriso -osirrox on -indev "$iso" -extract_boot_images "$efi_images" >/dev/null 2>&1
efi_image="$efi_images/gpt_part2_efi.img"
[[ -s $efi_image ]] || { echo 'rEFInd EFI partition missing from ISO' >&2; exit 1; }
mount -o loop,ro "$efi_image" "$efi_mount"
[[ -s $efi_mount/EFI/BOOT/$fallback &&
   -s $efi_mount/os/linux && -s $efi_mount/os/initrd ]] || {
    echo 'rEFInd live EFI files are incomplete' >&2; exit 1;
}
for icon in live check safe; do
    [[ -s $efi_mount/EFI/BOOT/infinity-theme/icons/os_infinityos_${icon}.png ]] || {
        echo "rEFInd $icon icon is missing" >&2; exit 1;
    }
done
cmp "$rootpoint/usr/share/rEFInd/refind/refind_${efi_arch}.efi" "$efi_mount/EFI/BOOT/$fallback"
cmp "$mountpoint/boot/$(uname -m)/loader/linux" "$efi_mount/os/linux"
cmp "$mountpoint/boot/$(uname -m)/loader/initrd" "$efi_mount/os/initrd"
grep -Fq 'menuentry "Infinity OS Live"' "$efi_mount/EFI/BOOT/refind.conf"
for icon in live check safe; do
    grep -Fq "icon /EFI/BOOT/infinity-theme/icons/os_infinityos_${icon}.png" "$efi_mount/EFI/BOOT/refind.conf"
done
grep -Fq 'rd.live.check' "$efi_mount/EFI/BOOT/refind.conf"
grep -Fq 'nomodeset' "$efi_mount/EFI/BOOT/refind.conf"
for required in \
    usr/libexec/infinityos-open-downloads \
    usr/local/share/applications/org.gnome.GPaste.Ui.desktop \
    usr/local/share/applications/org.gnome.GPaste.Preferences.desktop \
    usr/share/gnome-shell/extensions/tilingshell@ferrarodomenico.com/extension.js \
    usr/share/gnome-shell/extensions/tilingshell@ferrarodomenico.com/schemas/gschemas.compiled \
    usr/share/gnome-shell/extensions/caffeine@patapon.info/extension.js \
    usr/share/gnome-shell/extensions/GPaste@gnome-shell-extensions.gnome.org/extension.js \
    usr/share/gnome-shell/extensions/dash2dock-animated@infinityos.org/extension.js \
    usr/share/gnome-shell/extensions/dash2dock-animated@infinityos.org/schemas/gschemas.compiled \
    usr/share/gnome-shell/extensions/vertical-workspaces@G-dH.github.com/extension.js \
    etc/dconf/db/local; do
    [[ -f "$rootpoint/$required" ]] || {
        echo "Installed GNOME component missing from ISO: $required" >&2
        exit 1
    }
done
for desktop in org.gnome.GPaste.Ui.desktop org.gnome.GPaste.Preferences.desktop; do
    grep -qx 'NoDisplay=true' "$rootpoint/usr/local/share/applications/$desktop" || {
        echo "GPaste launcher is visible in the app grid: $desktop" >&2
        exit 1
    }
done
[[ -x "$rootpoint/usr/libexec/infinityos-open-downloads" ]] || {
    echo 'Downloads shortcut is not executable' >&2
    exit 1
}
defaults="$rootpoint/usr/share/infinityos/gnome-defaults"
grep -q "'tilingshell@ferrarodomenico.com'" "$defaults"
grep -q "'dash2dock-animated@infinityos.org'" "$defaults"
grep -q "'vertical-workspaces@G-dH.github.com'" "$defaults"
grep -q "'caffeine@patapon.info'" "$defaults"
grep -q "'GPaste@gnome-shell-extensions.gnome.org'" "$defaults"
grep -qx 'app-display-module=true' "$defaults"
grep -qx 'app-grid-performance=true' "$defaults"
grep -qx 'startup-state=1' "$defaults"
grep -qx 'downloads-icon=true' "$defaults"
grep -qx 'enable-all=true' "$rootpoint/usr/share/infinityos/blur-defaults"
rpm --root "$rootpoint" -q infinityos-shell-extensions >/dev/null || {
    echo 'Infinity OS shell extension package missing from ISO' >&2
    exit 1
}
for package in gnome-shell-extension-appindicator gnome-shell-extension-blur-my-shell gnome-shell-extension-caffeine gnome-shell-extension-gpaste gnome-shell-extension-user-theme gnome-shell-extension-vertical-workspaces; do
    if rpm --root "$rootpoint" -q "$package" >/dev/null 2>&1; then
        echo "Upstream GNOME extension package still installed in ISO: $package" >&2
        exit 1
    fi
done
for package in gnome-software mpv infinity-config infinity-terminal; do
    rpm --root "$rootpoint" -q "$package" >/dev/null || {
        echo "Default application missing from ISO: $package" >&2
        exit 1
    }
done
for required in \
    etc/profile.d/50-infinity-terminal-keybindings.sh \
    usr/share/infinityos/ghostty/keybindings.zsh; do
    [[ -f "$rootpoint/$required" ]] || {
        echo "InfinityTerminal keyboard shortcuts missing from ISO: $required" >&2
        exit 1
    }
done
grep -Fq 'source /usr/share/infinityos/ghostty/keybindings.zsh' "$rootpoint/etc/skel/.zshrc"
for package in gnome-builder ptyxis gnome-terminal gnome-console showtime totem; do
    if rpm --root "$rootpoint" -q "$package" >/dev/null 2>&1; then
        echo "Replaced default application still installed in ISO: $package" >&2
        exit 1
    fi
done
grep -qx 'video/mp4=mpv.desktop' "$rootpoint/etc/xdg/mimeapps.list"
grep -qx "exec='infinity-terminal'" "$defaults"
for unit in infinityos-drm-browser.timer infinityos-bazaar-install.timer; do
    if [[ -e "$rootpoint/usr/lib/systemd/system/$unit" ||
          -e "$rootpoint/etc/systemd/system/timers.target.wants/$unit" ||
          -L "$rootpoint/etc/systemd/system/timers.target.wants/$unit" ]]; then
        echo "Unwanted first-boot app installer in ISO: $unit" >&2
        exit 1
    fi
done
for package in \
    gnome-classic-session \
    gnome-shell-extension-apps-menu \
    gnome-shell-extension-background-logo \
    gnome-shell-extension-launch-new-instance \
    gnome-shell-extension-places-menu \
    gnome-shell-extension-window-list; do
    if rpm --root "$rootpoint" -q "$package" >/dev/null 2>&1; then
        echo "Unwanted GNOME extension package in ISO: $package" >&2
        exit 1
    fi
done
grep -qx 'Exec=gnome-session --session=gnome-login' \
    "$rootpoint/usr/share/gdm/greeter/wayland-sessions/gnome-greeter.desktop" || {
    echo 'Infinity OS login session fix missing from ISO' >&2
    exit 1
}
echo "Verified Infinity OS ISO from source revision $revision"
