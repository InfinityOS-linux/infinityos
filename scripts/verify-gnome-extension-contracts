#!/usr/bin/env python3
"""Reject mismatched bundled GNOME extensions before and after image builds."""

import ast
import json
import sys
from pathlib import Path


root = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent
extensions = root / "root/usr/share/gnome-shell/extensions"
defaults = root / "root/usr/share/infinityos/gnome-defaults"
source_tree = defaults.exists()
if not source_tree:
    extensions = root / "usr/share/gnome-shell/extensions"
    defaults = root / "usr/share/infinityos/gnome-defaults"

fedora_snapshot = root / "vendor/gnome-shell/fedora-44/usr/share/gnome-shell/extensions"
fedora_extensions = {
    "GPaste@gnome-shell-extensions.gnome.org",
    "appindicatorsupport@rgcjonas.gmail.com",
    "blur-my-shell@aunetx",
    "caffeine@patapon.info",
    "user-theme@gnome-shell-extensions.gcampax.github.com",
    "vertical-workspaces@G-dH.github.com",
}

lines = defaults.read_text().splitlines()
enabled_line = next(line for line in lines if line.startswith("enabled-extensions="))
enabled = ast.literal_eval(enabled_line.partition("=")[2])
new_dock = "dash2dock-animated@infinityos.org"
old_dock = "dash2dock-lite@icedman.github.com"
if new_dock not in enabled or old_dock in enabled:
    raise SystemExit("Infinity OS dock UUID is missing or the upstream UUID is still enabled")

vshell_section = defaults.read_text().split(
    "[org/gnome/shell/extensions/vertical-workspaces]\n", 1
)[1].split("\n[", 1)[0]
vshell_defaults = dict(
    line.split("=", 1) for line in vshell_section.splitlines() if "=" in line
)
expected_vshell_defaults = {
    "app-grid-folder-center": "true",
    "notification-position": "2",
    "hot-corner-action": "2",
    "ws-max-spacing": "10",
    "ws-preview-scale": "80",
    "ws-sw-popup-v-position": "85",
    "ws-thumbnail-scale": "7",
    "ws-thumbnail-scale-appgrid": "11",
    "ws-thumbnails-position": "5",
    "wst-position-adjust": "0",
}
for key, value in expected_vshell_defaults.items():
    if vshell_defaults.get(key) != value:
        raise SystemExit(f"Infinity OS V-Shell default {key} must be {value}")

if (extensions / old_dock).exists():
    raise SystemExit("The upstream dock UUID would conflict with the Infinity OS fork")

for directory in extensions.iterdir():
    if not directory.is_dir() or not (directory / "metadata.json").exists():
        continue
    actual = json.loads((directory / "metadata.json").read_text()).get("uuid")
    if actual != directory.name:
        raise SystemExit(f"GNOME extension UUID mismatch: {directory.name} != {actual}")

if source_tree:
    for uuid in fedora_extensions:
        metadata = fedora_snapshot / uuid / "metadata.json"
        if not metadata.is_file() or json.loads(metadata.read_text()).get("uuid") != uuid:
            raise SystemExit(f"Vendored Fedora extension missing or mismatched: {uuid}")

dock = extensions / new_dock
for name in ("extension.js", "dockItemMenu.js", "folderClick.js", "metadata.json"):
    if not (dock / name).is_file():
        raise SystemExit(f"Infinity OS dock file missing: {name}")
if "./folderClick.js" not in (dock / "dockItemMenu.js").read_text():
    raise SystemExit("Empty-folder behavior is no longer connected to the dock")

if not source_tree:
    links = {
        "00-infinityos": "/usr/share/infinityos/gnome-defaults",
        "01-infinity-blur": "/usr/share/infinityos/blur-defaults",
    }
    for name, target in links.items():
        if (root / "etc/dconf/db/local.d" / name).readlink().as_posix() != target:
            raise SystemExit(f"Infinity OS dconf default is not package-linked: {name}")
    for uuid in enabled:
        metadata = extensions / uuid / "metadata.json"
        if not metadata.is_file():
            raise SystemExit(f"Enabled GNOME extension missing from image: {uuid}")

print("Verified GNOME extension UUIDs and Infinity OS dock behavior")
